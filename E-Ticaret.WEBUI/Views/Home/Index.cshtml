@model IEnumerable<E_Ticaret.Core.Entities.Product>
@{
    ViewData["Title"] = "Home Page";
}

<partial name="_SLider" />
<!-- Özellikler Kutuları -->
<section class="features-section">
    <div class="features-container">
        <div class="feature-box">
            <i class="fa-solid fa-shield-halved"></i>
            <h3>Güvenli Alışveriş</h3>
        </div>
        <div class="feature-box">
            <i class="fa-solid fa-paper-plane"></i>
            <h3>Hızlı Teslimat</h3>
        </div>
        <div class="feature-box">
            <i class="fa-solid fa-seedling"></i>
            <h3>Taze Çiçekler</h3>
        </div>
        <div class="feature-box">
            <i class="fa-solid fa-face-smile"></i>
            <h3>Mutlu Müşteriler</h3>
        </div>
    </div>
</section>

<!-- Ürün Listesi Bölümü -->
<section class="products-section">
    <div class="section-header">
        <h2>Sizin İçin Seçtiğimiz Ürünler</h2>
    </div>

    <div class="products-grid">
        <!-- Ürün 1 -->

        @foreach (var item in Model)
        {
            <div class="product-card">
                <a href="/product/detail?productCode=@item.ProductCode" class="product-link">
                    <div class="product-image">
                        <img src="/img/@item.Image" alt="@item.Name">
                        <div class="quick-view">
                            <i class="fa-solid fa-eye"></i>
                        </div>
                    </div>
                    <div class="product-info">
                        <h3 class="product-title">@item.Name</h3>
                        <div class="product-price">@item.Price.ToString("c")</div>
                    </div>
                </a>

                <form asp-action="AddItemToCart" asp-controller="Cart">
                    <input type="hidden" name="productId" value="@item.Id" />
                    <input type="hidden" value="1" name="quantity" />
                    <button class="add-to-cart-btn" type="submit"> <i class="fa-solid fa-cart-plus"></i> Sepete Ekle</button>
                </form>
            </div>
        }

    </div>
</section>

