@model IEnumerable<E_Ticaret.Core.Entities.Product>
@{
    ViewData["Title"] = "Ana Sayfa";
}

<partial name="_SLider" />

<!-- Özellikler Kutuları -->
<section class="features-section">
    <div class="features-container">
        <div class="feature-box">
            <i class="fa-solid fa-shield-halved"></i>
            <h3>Güvenli Alışveriş</h3>
        </div>
        <div class="feature-box">
            <i class="fa-solid fa-paper-plane"></i>
            <h3>Hızlı Teslimat</h3>
        </div>
        <div class="feature-box">
            <i class="fa-solid fa-seedling"></i>
            <h3>Taze Çiçekler</h3>
        </div>
        <div class="feature-box">
            <i class="fa-solid fa-face-smile"></i>
            <h3>Mutlu Müşteriler</h3>
        </div>
    </div>
</section>

@* Sizin İçin Seçilen Ürünler *@
<section class="products-section">
    <div class="section-header">
        <h2>Sizin İçin Seçtiğimiz Ürünler</h2>
    </div>

    <div class="products-grid">
        @foreach (var item in Model.OrderByDescending(x => x.OrderNo).Where(x=>x.IsHome))
        {
            var imageUrl = item.ProductImages?.FirstOrDefault(x => x.IsDefault)?.ImageUrl
                 ?? item.ProductImages?.FirstOrDefault()?.ImageUrl
                 ?? "no-image.png";

            <div class="product-card">
                <div class="product-image" style="position: relative;">
                    <a href="/product/detail?productCode=@item.ProductCode" class="product-link">
                        <img src="/img/@imageUrl" alt="@item.Name">
                    </a>
                    <div class="quick-view"
                         data-name="@item.Name"
                         data-image="/img/@imageUrl"
                         data-price="@item.Price.ToString("c")"
                         data-description="@(item.Description ?? "")"
                         data-productid="@item.Id">
                        <i class="fa-solid fa-eye" style="color: #2E8B57; font-size: 18px;"></i>
                    </div>
                </div>
                <div class="product-info">
                    <h3 class="product-title">@item.Name</h3>
                    <div class="product-price">@item.Price.ToString("c")</div>
                </div>
                <form asp-action="AddItemToCart" asp-controller="Cart">
                    <input type="hidden" name="productId" value="@item.Id" />
                    <input type="hidden" value="1" name="quantity" />
                    <button class="add-to-cart-btn" type="submit">
                        <i class="fa-solid fa-cart-plus"></i> Sepete Ekle
                    </button>
                </form>
            </div>
        }
    </div>
</section>

