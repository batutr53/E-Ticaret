@model E_Ticaret.Core.Entities.Contact

@{
    ViewData["Title"] = "İletişim";
}
<section class="contactUs-container">
    <div class="contactUs-wrapper">
        <div class="contactUs-info">
            <h2>İletişim Bilgileri</h2>
            <p><i>📞</i> 0216 594 50 50 - 0216 594 77 94</p>
            <p><i>📞</i> 0533 361 25 54</p>
            <p><i>📧</i> info@detaycicek.com</p>
            <p><i>📍</i> Çamlık Mahallesi Şenol Güneş Bulvarı No:46 Ümraniye/İstanbul</p>
            </br>
            <p><i>📍</i>HALKBANK - EYYÜP YAPMAZ - TR 62 0001 2009 8500 0001 519678</p>
            <p><i>📍</i>HALKBANK - EYYÜP YAPMAZ - TR 74 0001 2009 8500 0009 216606</p>
            <p><i>📍</i>YAPI KREDİ - EYYÜP YAPMAZ - TR 30 0006 7010 0000 0043 549648</p>
        </div>

        <div class="contactUs-form">
            <h2>İletişim Formu</h2>
            <form action="/Home/ContactUsPost" method="post">
                <input type="text" asp-for="NameSurname" placeholder="Adınız Soyadınız" required />
                <input type="email" asp-for="Email" placeholder="E-Posta" required />
                <input type="tel" asp-for="Phone" placeholder="Telefon Numaranız" required />
                <input type="text" asp-for="Subject" placeholder="Başlık" required />
                <textarea placeholder="Mesajınız" asp-for="Message" required></textarea>
                <div class="contactUs-recaptcha">
                    <label>
                        <input type="checkbox" required /> Ben robot değilim
                    </label>
                    <img src="https://www.gstatic.com/recaptcha/api2/logo_48.png" alt="reCAPTCHA" />
                </div>
                <button type="submit">Gönder</button>
            </form>
        </div>
    </div>

    <div class="contactUs-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3011.220305364333!2d29.12025607551343!3d40.99855102002451!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cac8a461a4f97f%3A0xf612d30e6068c4f6!2zw4dhbWzEsWssIMWeZW5vbCBHw7xuZcWfIEJsdi4gTm86NDYsIDM0Nzc0IMOcbXJhbml5ZS_EsHN0YW5idWw!5e0!3m2!1str!2str!4v1744704660067!5m2!1str!2str" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
</section>
