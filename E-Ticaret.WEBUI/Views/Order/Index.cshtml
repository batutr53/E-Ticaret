
<div class="gonderici-container">
    <form asp-action="CreateOrder" method="post">
        <div class="gonderici-form-section">
            <div class="gonderici-form-group">
                <div class="gonderici-input-icon">
                    <i class="fas fa-user"></i>
                    <input type="text" class="gonderici-input-control" placeholder="Gönderici Adı Soyadı">
                </div>
            </div>

            <div class="gonderici-form-group">
                <div class="gonderici-input-icon">
                    <i class="fas fa-phone"></i>
                    <input type="tel" class="gonderici-input-control" placeholder="Gönderici Telefon">
                </div>
            </div>

            <div class="gonderici-form-group">
                <div class="gonderici-input-icon">
                    <i class="fas fa-envelope"></i>
                    <input type="email" class="gonderici-input-control" placeholder="Gönderici E-Posta Adresi">
                </div>
            </div>

            <div class="gonderici-checkbox-group">
                <input type="checkbox" id="sms" class="gonderici-checkbox" checked>
                <label for="sms" class="gonderici-label">SMS Durum bilgilendirmesi Yapılsın</label>
            </div>

            <div class="gonderici-form-group">
                <textarea class="gonderici-textarea" placeholder="Bize İletmek İstedikleriniz (Lütfen saat teslimi talepleri için telefon ile arayınız.)"></textarea>
            </div>

            <div class="gonderici-checkbox-group">
                <input type="checkbox" id="fatura" class="gonderici-checkbox">
                <label for="fatura" class="gonderici-label">Fatura Bilgilerini Gir</label>
            </div>

            <div class="gonderici-checkbox-group">
                <input type="checkbox" id="marketing" class="gonderici-checkbox">
                <label for="marketing" class="gonderici-label">www.atesgulucicek.com tarafından tarafıma ticari elektronik ileti gönderilmesine izin veriyorum.</label>
            </div>

            <div class="gonderici-checkbox-group">
                <input type="checkbox" id="privacy" class="gonderici-checkbox">
                <label for="privacy" class="gonderici-label">Kişisel Bilgi Toplama Prosedürü Gizlilik Politikası'nı okudum ve kabul ediyorum.</label>
            </div>
        </div>
    </form>
    <!-- Order Summary -->
    <div class="gonderici-order-summary">
        <h2 class="gonderici-summary-title">Sipariş Özetiniz</h2>

        <div class="gonderici-summary-product">
            <img src="/img/100.png" alt="Jolie Çiçek Aranjman" class="gonderici-summary-img">
            <div class="gonderici-summary-info">
                <p class="gonderici-summary-name">Çiçek</p>
                <p>Jolie Çiçek Aranjman</p>
            </div>
            <p class="gonderici-summary-price">4000.00 TL</p>
        </div>

        <div class="gonderici-delivery-info">
            <h3 class="gonderici-delivery-title">Teslimat Bilgileri</h3>
            <p class="gonderici-delivery-address">Aksaray, İstanbul Avrupa Yakası 30 Mart 2025 09:30 - 16:30</p>
            <p><strong>Yol Ücreti:</strong> 50 TL</p>
        </div>

        <div class="gonderici-price-summary">
            <h3 class="gonderici-price-title">Ürün Toplam Fiyat</h3>
            <p class="gonderici-price-item">(KDV Dahil)</p>
            <p class="gonderici-price-value">4050,00 TL</p>


            <div class="gonderici-total-price">
                <span>Toplam Ödeme Tutarı (KDV Dahil)</span>
                <span>4050 TL</span>
            </div>
        </div>
    </div>

    <!-- Bottom Navigation -->
    <div class="gonderici-bottom-nav">
        <a href="#" class="gonderici-back-btn">
            <i class="fas fa-arrow-left"></i> Sipariş bilgilerini düzenle
        </a>
        <button class="gonderici-next-btn">Sonraki Adım</button>
    </div>
</div>
