@using E_Ticaret.Core.Entities
@using System.Globalization
@{
    var provinces = ViewBag.DeliveryProvinces as List<AddressProvince> ?? new();
}
<link rel="stylesheet" href="~/css/order.css" asp-append-version="true">

<div class="steporder-container">
    <ul class="steporder-steps">
        <li class="active">Gönderici</li>
        <li>Alıcı</li>
        <li>Sipariş</li>
        <li>Ödeme</li>
    </ul>

    <form id="steporder-form" asp-action="CreateOrder" asp-controller="Order" method="post">
        <!-- STEP 1 -->
        <div class="steporder-step" data-step="1">
            <h2>Gönderici Bilgileri</h2>
            <div class="gonderici-container">
                <div class="gonderici-form-section">
                    <div class="gonderici-form-group">
                        <div class="gonderici-input-icon">
                            <i class="fas fa-user"></i>
                            <input type="text" class="gonderici-input-control" name="SenderFirstLastName"
                                   placeholder="Gönderici Adı Soyadı" minlength="2" maxlength="60" pattern="^[A-Za-zÇçĞğİıÖöŞşÜü\s]+$" required>
                        </div>
                    </div>

                    <div class="gonderici-form-group">
                        <div class="gonderici-input-icon">
                            <i class="fas fa-phone"></i>
                            <input type="tel" class="gonderici-input-control" name="SenderPhone"
                                   placeholder="Gönderici Telefon" minlength="10" maxlength="15" pattern="^\d{10,15}$" required>
                        </div>
                    </div>

                    <div class="gonderici-form-group">
                        <div class="gonderici-input-icon">
                            <i class="fas fa-envelope"></i>
                            <input type="email" class="gonderici-input-control" name="SenderEmail"
                                   placeholder="Gönderici E-Posta Adresi" minlength="5" maxlength="100" required>
                        </div>
                    </div>

                    @*<div class="gonderici-checkbox-group">
                            <input type="checkbox" id="sms" class="gonderici-checkbox" checked>
                            <label for="sms" class="gonderici-label">SMS Durum bilgilendirmesi Yapılsın</label>
                        </div>*@

                    <div class="gonderici-form-group">
                        <label for="cardMessage" class="checkout-field-label">Çiçek Kartına Yazılacak Not</label>
                        <p id="cardMessageHelp" class="checkout-field-help">Bu mesaj çiçekle birlikte alıcıya gönderilecek karta yazılır. İsterseniz sonuna adınızı ekleyebilirsiniz.</p>
                        <textarea id="cardMessage" class="gonderici-textarea" name="CardMessage" rows="4" aria-describedby="cardMessageHelp"
                                  placeholder="Örnek: İyi ki doğdun! Seni çok seviyorum. — Ayşe" maxlength="500"></textarea>
                    </div>
                    <div class="gonderici-form-group">
                        <label for="deliveryInstructions" class="checkout-field-label">Teslimat / Sipariş Talebiniz (İsteğe bağlı)</label>
                        <p id="deliveryInstructionsHelp" class="checkout-field-help">Bu alan işletmemiz içindir; karta yazılmaz. Kesin saat talepleri için lütfen bizi arayın.</p>
                        <textarea id="deliveryInstructions" class="gonderici-textarea" name="Description" aria-describedby="deliveryInstructionsHelp"
                                  placeholder="Örnek: Teslimattan önce alıcıyı arayabilirsiniz." maxlength="500"></textarea>
                    </div>
                    <div class="gonderici-form-group">
                        <div class="gonderici-input-icon">
                            <i class="fas fa-calendar"></i>
                            <input type="date" class="gonderici-input-control" name="DeliveryDate" id="deliveryDate"
                                   required min="@DateTime.Now.ToString("yyyy-MM-dd")" placeholder="Teslimat Tarihi:" />
                        </div>
                    </div>

                    <div class="gonderici-form-group">
                        <div class="gonderici-input-icon">
                            <label for="deliveryTimeRangeId"></label>
                            <select class="gonderici-input-control" name="DeliveryTimeRangeId" id="deliveryTimeRangeId" placeholder="Teslimat Saat Aralığı:" required>
                                <option value="">Saat Aralığı Seçiniz</option>
                                @foreach (var time in ViewBag.DeliveryTimeRanges as List<E_Ticaret.Core.Entities.DeliveryTimeRange>)
                                {
                                    <option value="@time.Id">@time.RangeText</option>
                                }
                            </select>
                        </div>
                    </div>
                    @*<div class="gonderici-checkbox-group">
                            <input type="checkbox" id="fatura" class="gonderici-checkbox">
                            <label for="fatura" class="gonderici-label">Fatura Bilgilerini Gir</label>
                        </div>*@

                    @*<div class="gonderici-checkbox-group">
                            <input type="checkbox" id="marketing" class="gonderici-checkbox">
                            <label for="marketing" class="gonderici-label">www.detayçiçekçilik.com tarafından tarafıma ticari elektronik ileti gönderilmesine izin veriyorum.</label>
                        </div>*@

                    @*<div class="gonderici-checkbox-group">
                            <input type="checkbox" id="privacy" class="gonderici-checkbox">
                            <label for="privacy" class="gonderici-label">Kişisel Bilgi Toplama Prosedürü Gizlilik Politikası'nı okudum ve kabul ediyorum.</label>
                        </div>*@
                </div>
            </div>
            <button type="button" class="steporder-next">İleri</button>
        </div>

        <!-- STEP 2 -->
        <div class="steporder-step" data-step="2">
            <h2>Alıcı Bilgileri</h2>
            <div class="checkout-address-picker">
                <div class="gonderici-form-group">
                    <label for="deliveryProvinceId" class="checkout-field-label">Teslimat İli</label>
                    <select id="deliveryProvinceId" name="ProvinceId" class="gonderici-input-control" required>
                        <option value="">İl seçiniz</option>
                        @foreach (var province in provinces) { <option value="@province.Id">@province.Name</option> }
                    </select>
                </div>
                <div class="gonderici-form-group">
                    <label for="deliveryDistrictId" class="checkout-field-label">Teslimat İlçesi</label>
                    <select id="deliveryDistrictId" name="DistrictId" class="gonderici-input-control" required disabled><option value="">Önce il seçiniz</option></select>
                </div>
                <div class="gonderici-form-group">
                    <label for="deliveryNeighborhoodId" class="checkout-field-label">Teslimat Mahallesi</label>
                    <select id="deliveryNeighborhoodId" name="NeighborhoodId" class="gonderici-input-control" required disabled aria-describedby="deliveryAddressHelp"><option value="">Önce ilçe seçiniz</option></select>
                    <input type="hidden" name="QuotedDeliveryFee" id="quotedDeliveryFee" />
                    <p id="deliveryAddressHelp" class="checkout-field-help">Yalnızca teslimat yaptığımız mahalleler listelenir. Yol ücreti seçtiğiniz mahalleye göre otomatik hesaplanır.</p>
                    <p id="deliveryAddressStatus" role="status" aria-live="polite" class="checkout-field-help"></p>
                    @if (provinces.Count == 0) { <p role="alert">Şu anda teslimata açık mahalle bulunmuyor. Lütfen işletmemizle iletişime geçin.</p> }
                </div>
            </div>
            <div class="gonderici-container">
                <div class="gonderici-form-section">
                    <div class="gonderici-form-group">
                        <div class="gonderici-input-icon">
                            <i class="fas fa-user"></i>
                            <input type="text" class="gonderici-input-control" name="FirstLastName"
                                   placeholder="Alıcı Adı Soyadı" required minlength="2" maxlength="100" pattern="^[A-Za-zÇçĞğİıÖöŞşÜü\s]+$" />
                        </div>
                    </div>
                    <div class="gonderici-form-group">
                        <div class="gonderici-input-icon">
                            <i class="fas fa-address-card"></i>
                            <input type="text" class="gonderici-input-control" name="AddressLine" placeholder="Cadde / sokak, bina ve daire numarası"
                                   required minlength="5" maxlength="400" />
                        </div>
                    </div>
                    <div class="gonderici-form-group">
                        <div class="gonderici-input-icon">
                            <i class="fas fa-phone"></i>
                            <input type="tel" class="gonderici-input-control" name="Phone" placeholder="Alıcı Telefon"
                                   required minlength="10" maxlength="15" pattern="^\d{10,15}$" />
                        </div>
                    </div>
                    <div class="steporder-buttons">
                        <button type="button" class="steporder-prev">Geri</button>
                        <button type="button" class="steporder-next">İleri</button>
                    </div>
                </div>
            </div>
        </div>
        <!-- STEP 3 -->
        <div class="steporder-step" data-step="3">
            <h2>Sipariş Detayı</h2>
            @await Component.InvokeAsync("OrderDetail")
            <div class="steporder-buttons">
                <button type="button" class="steporder-prev">Geri</button>
                <button type="button" class="steporder-next">İleri</button>
            </div>
        </div>

        <!-- STEP 4 -->
        <div class="steporder-step" data-step="4">
            <h2>Ödeme</h2>
            <div class="gonderici-container">
                <div class="gonderici-form-section">
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-lock"></i>
                        Kart bilgileriniz bir sonraki ekranda PayTR'ın güvenli ödeme formunda alınacaktır.
                    </div>
                    <div class="checkout-payment-summary" aria-live="polite">
                        <p>Teslimat adresi: <strong data-checkout-address>Mahalle seçiniz</strong></p>
                        <p>Ürünler: <strong data-checkout-subtotal></strong></p>
                        <p>Yol ücreti: <strong data-checkout-fee></strong></p>
                        <p>Ödenecek toplam: <strong data-checkout-total></strong></p>
                    </div>

                    <div class="steporder-buttons">
                        <button type="button" class="steporder-prev">Geri</button>
                        <input type="submit" value="PayTR ile Güvenli Öde" class="btn btn-primary" disabled="@(provinces.Count == 0)" data-delivery-unavailable="@(provinces.Count == 0 ? "true" : "false")" />
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>


<script src="~/js/delivery-address.js" asp-append-version="true"></script>
<script src="~/js/order.js" asp-append-version="true"></script>
