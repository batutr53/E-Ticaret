@model E_Ticaret.Core.DTO.PaymentResponseDTO

<div class="payment-result-container">
    @if (Model.ResultCode == "0000")
    {
        <div class="payment-success">
            <h1 class="payment-title">Ödeme Başarılı 🎉</h1>
            <p class="payment-info"><strong>İşlem No:</strong> @Model.TxnNo</p>
            <p class="payment-info"><strong>Sipariş No:</strong> @Model.Oid</p>
            <p class="payment-info"><strong>Ödeme Tutarı:</strong> @Model.Amount TL</p>
            <p class="payment-message">Teşekkür ederiz! Siparişiniz başarıyla alınmıştır.</p>

            <a href="/" class="payment-btn-primary">Ana Sayfaya Dön</a>
        </div>
    }
    else
    {
        <div class="payment-error">
            <h1 class="payment-title">Ödeme Başarısız ❌</h1>
            <p class="payment-info"><strong>İşlem No:</strong> @Model.TxnNo</p>
            <p class="payment-info"><strong>Hata Kodu:</strong> @Model.ResultCode</p>
            <p class="payment-info"><strong>Açıklama:</strong> @Model.ResultDetail</p>

            <p class="payment-message">Ödeme işleminiz sırasında bir hata oluştu. Lütfen tekrar deneyiniz.</p>

            <a href="/" class="payment-btn-danger">Ana Sayfaya Dön</a>
        </div>
    }
</div>