@model E_Ticaret.Core.Entities.Category
@{

    ViewData["Title"] = Model.Name ?? "Kategoriler";
}

<section class="products-section">
    <div class="section-header">
        <h2>@Model.Name</h2>
    </div>

    <div class="products-grid">

        @foreach (var item in Model.Products)
        {
            <div class="product-card">
                <a href="/product/detail?productCode=@item.ProductCode" class="product-link">
                    <div class="product-image">
                        <img src="/img/@item.Image" alt="@item.Name">
                        <div class="quick-view">
                            <i class="fa-solid fa-eye"></i>
                        </div>
                    </div>
                    <div class="product-info">
                        <h3 class="product-title">@item.Name</h3>
                        <div class="product-price">@item.Price.ToString("c")</div>
                    </div>
                </a>
                <button class="add-to-cart-btn">
                    <i class="fa-solid fa-cart-plus"></i> Sepete Ekle
                </button>
            </div>

        }

    </div>
</section>