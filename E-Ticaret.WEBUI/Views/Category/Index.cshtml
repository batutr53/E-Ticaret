@model E_Ticaret.Core.Entities.Category

@{
    ViewData["Title"] = Model?.Name ?? "Kategoriler";
}
<style>
    .pagination-container {
        text-align: center;
        margin-top: 20px;
    }

    .pagination {
        list-style: none;
        padding: 0;
        display: inline-flex;
        gap: 5px;
    }

    .page-item {
        display: inline;
    }

    .page-link {
        display: block;
        padding: 6px 12px;
        background: #f0f0f0;
        border-radius: 4px;
        text-decoration: none;
        color: #333;
    }

    .page-item.active .page-link {
        background: #66dc1d;
        color: white;
        font-weight: bold;
    }

</style>
<section class="products-section">
    <div class="section-header">
        <h2>@(Model?.Name ?? "Kategoriler")</h2>
    </div>

    <div class="products-grid">
        @if (Model?.ProductCategories != null && Model.ProductCategories.Any())
        {
            foreach (var item in Model.ProductCategories.Select(pc => pc.Product))
            {
                <div class="product-card">
                    <div class="product-image">
                        <a href="/product/detail?productCode=@item.ProductCode" class="product-link">
                            <img src="/img/@(item.ProductImages?.FirstOrDefault(x => x.IsDefault)?.ImageUrl
                 ?? item.ProductImages?.FirstOrDefault()?.ImageUrl
                 ?? "no-image.png")"
                                 alt="@item.Name" />
                        </a>
                    </div>

                    <div class="product-info">
                        <h3 class="product-title">@item.Name</h3>
                        <div class="product-price">@item.Price.ToString("C")</div>
                    </div>

                    <form asp-action="AddItemToCart" asp-controller="Cart">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <input type="hidden" value="1" name="quantity" />
                        <button class="add-to-cart-btn" type="submit">
                            <i class="fa-solid fa-cart-plus"></i> Sepete Ekle
                        </button>
                    </form>
                </div>

            }
        }
        else
        {
            <div class="no-products-message">
                <p>Bu kategoriye ait ürün bulunamadı veya kategori bilgisi alınamadı.</p>
            </div>
        }
    </div>
    <div class="pagination-container">
        <ul class="pagination">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { id = ViewBag.CategoryId, page = i })">@i</a>
                </li>
            }
        </ul>
    </div>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="product-details-section">
            <div class="product-details-content">
                @Html.Raw(Model.Description)
            </div>
        </div>
    }

</section>
