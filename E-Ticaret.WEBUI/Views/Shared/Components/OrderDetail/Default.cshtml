@model E_Ticaret.Core.Entities.Cart
@using E_Ticaret.WEBUI.Helpers

@{
    var totalPrice = 0m;
}

<div class="basket-main-content">
    <div class="basket-product-card">
        @if (Model.CartItems.Any())
        {
            foreach (var item in Model.CartItems)
            {
                var imageUrl = item.Product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "no-image.png";
                var lineTotal = item.Product.Price * item.Quantity;
                totalPrice += lineTotal;

                <div class="basket-product-header">
                    <a href="/urun/@item.Product.ProductCode/@SeoSlugHelper.Generate(item.Product.Name)">
                        <img src="/img/@imageUrl" alt="@item.Product.Name" class="basket-product-img" />
                    </a>

                    <div class="basket-product-details">
                        <h3>@item.Product.Name</h3>

                        <div class="basket-quantity-wrapper">
                            <span class="decrease-form">
                                <input type="hidden" name="ProductId" value="@item.Product.Id" disabled />
                            </span>

                            <input type="text" class="basket-quantity-input" value="@item.Quantity" readonly />

                            <span class="increase-form">
                                <input type="hidden" name="productId" value="@item.Product.Id" disabled />
                            </span>
                        </div>

                        <p class="basket-product-price">@item.Product.Price.ToString("c")</p>
                    </div>
                </div>
            }

            <div class="basket-order-summary">
                <div class="basket-price-summary">
                    <h3 class="basket-price-title">Ürün Toplam Fiyat</h3>
                    <p class="basket-price-value">@totalPrice.ToString("c")</p>

                    <div class="basket-total-price">
                        <span>Toplam Ödeme Tutarı</span>
                        <span>@totalPrice.ToString("c")</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <span>Sepette ürün bulunmamaktadır.</span>
        }
    </div>
</div>
