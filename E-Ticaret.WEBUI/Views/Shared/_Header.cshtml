<div class="top-bar">
    <div class="top-links">
        <a class="fa-solid fa-info-circle" asp-area="" asp-controller="Home" asp-action="About">Hakkımızda</a>
    </div>
    <div class="social-icons">
        @*   <a href="#"><i class="fab fa-instagram"></i></a>
        <a href="#"><i class="fab fa-youtube"></i></a>
        <a href="#"><i class="fab fa-linkedin-in"></i></a> *@
    </div>
    <div class="auth-links">
        @*      <a href="#"><i class="fa-solid fa-right-to-bracket"></i> Giriş Yapın</a>
        <a href="#"><i class="fa-solid fa-user-plus"></i> Üye Olun</a> *@
        <a asp-controller="Order" asp-action="GetOrder"><i class="fa-solid fa-truck-fast"></i> Sipariş Takibi</a>
    </div>
</div>
<!-- Main Header -->
<header class="main-header">
    <a href="/" class="logo">
        <img src="/img/logo.png" height="150" width="100" alt="Detay Çiçekçilik">
    </a>
    <div class="phone-number">
        <i class="fa-solid fa-phone phone-icon"></i>
        +90 216 594 50 50
    </div>
    <form action="/Product/">
        <div class="search-container">
            <input name="q" type="text" class="search-input" placeholder="Ne Aramıştınız?" aria-label="Arama">
            <button class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
        </div>
    </form>
</header> <!-- Navigation -->
<nav class="main-nav">
    <div class="nav-container">
        <button class="mobile-menu-btn">
            <i class="fa-solid fa-bars"></i>
        </button>
        <ul class="nav-links">
            <li><a href="/"><i class="fa-solid fa-house"></i></a></li>
            <li class="has-dropdown">
                <a href="#"><i class="fa-solid fa-list-ul"></i> KATEGORİLERİMİZ <i class="fa-solid fa-chevron-down"></i></a>
                <div class="dropdown-menu">
                    <div class="dropdown-content">
                        @await Component.InvokeAsync("Categories")
                    </div>
                </div>
            </li>
            <li><a href="#"><i class="fa-solid fa-truck-fast"></i> GÖNDERİM TÜRÜ</a></li>
            <li><a href="#"><i class="fa-solid fa-gift"></i> KADINLAR GÜNÜ ÇİÇEKLERİ</a></li>
            <li><a href="#"><i class="fa-solid fa-leaf"></i> ARANJMANLAR</a></li>
            <li><a href="#"><i class="fa-solid fa-seedling"></i> ORKİDELER</a></li>
            <li><a href="#"><i class="fa-solid fa-fan"></i> ÇİÇEK BUKETLERİ</a></li>
        </ul>
        <div class="cart-container">
            @await Component.InvokeAsync("Basket")
        </div>
    </div>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu">
    <button class="mobile-menu-close">
        <i class="fa-solid fa-xmark"></i>
    </button>
    <ul>
        <li><a href="/"><i class="fa-solid fa-house"></i> Anasayfa</a></li>
        <li class="mobile-category">
           
                <a class="toggle-submenu">
                    <span><i class="fa-solid fa-list-ul"></i> Kategorilerimiz</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </a>
          
            <div class="mobile-category-content">
                @await Component.InvokeAsync("Categories")
            </div>
        </li>
        <li><a href="#"><i class="fa-solid fa-gift"></i> Kadınlar Günü Çiçekleri</a></li>
        <li><a href="#"><i class="fa-solid fa-leaf"></i> Aranjmanlar</a></li>
        <li><a href="#"><i class="fa-solid fa-seedling"></i> Orkideler</a></li>
        <li><a href="#"><i class="fa-solid fa-fan"></i> Çiçek Buketleri</a></li>
        <li><a href="/Home/About"><i class="fa-solid fa-info-circle"></i> Hakkımızda</a></li>
        <li><a href="/Home/ContactUs"><i class="fa-solid fa-envelope"></i> İletişim</a></li>
    </ul>
</div>
