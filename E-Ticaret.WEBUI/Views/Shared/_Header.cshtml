@model E_Ticaret.WEBUI.Models.HeaderViewModel
@{
    var logo = string.IsNullOrWhiteSpace(Model.SiteSetting.Logo) ? "logo.png" : Model.SiteSetting.Logo;
}
<div class="top-bar">
    <div class="top-links">
        <a asp-area="" asp-controller="Home" asp-action="About">Hakkımızda</a>
    </div>
    <div class="social-icons">
        <a href="https://www.instagram.com/detayflowers" target="_blank">
            <i class="fa-brands fa-instagram fa-3x"></i>
        </a>
    </div>
    <div class="auth-links">
        @*      <a href="#"><i class="fa-solid fa-right-to-bracket"></i> Giriş Yapın</a>
            <a href="#"><i class="fa-solid fa-user-plus"></i> Üye Olun</a> *@
        <a asp-controller="Order" asp-action="GetOrder"><i class="fa-solid fa-truck-fast"></i> Sipariş Takibi</a>
    </div>
</div>
<!-- Main Header -->
<header class="main-header">
    <a href="/" class="logo">
        <img src="/img/@logo" height="150" width="100" alt="Detay Çiçekçilik">
    </a>

    <div class="contact-numbers">

        <div class="phone-row">
            <i class="fa-solid fa-phone phone-icon"></i>
            <a href="tel:+905333612554">+90 533 361 25 54</a>
        </div>
        <div class="phone-row">
            <i class="fa-solid fa-phone phone-icon"></i>
            <a href="tel:+902165945050">+90 216 594 50 50</a>
        </div>
    </div>


    <form action="/Product/">
        <div class="search-container">
            <input name="q" type="text" class="search-input" placeholder="Ne Aramıştınız?" aria-label="Arama">
            <button class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
        </div>
    </form>
</header>
<nav class="main-nav" id="mainNavbar">
    <div class="nav-container">
        <!-- Home Icon -->
        <a href="/" class="nav-home">
            <i class="fas fa-home"></i>
        </a>

        <!-- Mobile Toggle -->
        <button type="button" class="mobile-toggle" onclick="toggleMobileMenu(this)"
                aria-label="Menüyü aç veya kapat" aria-controls="mainMenu" aria-expanded="false">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

        <!-- Main Menu -->
        <div class="main-menu" id="mainMenu">

            <div class="menu-item">
                <a href="#" onclick="toggleDropdown(event, 'menu-one')">
                    KATEGORİLER
                    @if (Model.CategoriesCount > 1)
                    {
                        <i class="fa-solid fa-chevron-down menu-chevron" aria-hidden="true"></i>
                    }
                </a>
                <div class="dropdown-menu menu-one">
                    @await Component.InvokeAsync("Categories")
                </div>
            </div>

            <div class="menu-item">
                <a href="#" onclick="toggleDropdown(event, 'menu-two')">
                    GÖNDERİM TÜRÜ
                    @if (Model.DeliveryTypesCount > 1)
                    {
                        <i class="fa-solid fa-chevron-down menu-chevron" aria-hidden="true"></i>
                    }
                </a>
                <div class="dropdown-menu menu-two">
                    @await Component.InvokeAsync("CategoriesTwo")
                </div>
            </div>

            <div class="menu-item">
                <a href="#" onclick="toggleDropdown(event, 'menu-three')">
                    YAPAY ÇİÇEKLER
                    @if (Model.ArtificialFlowersCount > 1)
                    {
                        <i class="fa-solid fa-chevron-down menu-chevron" aria-hidden="true"></i>
                    }
                </a>
                <div class="dropdown-menu menu-three">
                    @await Component.InvokeAsync("CategoriesThree")
                </div>
            </div>

            @await Component.InvokeAsync("CategoriesMain")
        </div>


        <!-- Cart Section -->
        <div class="nav-cart">
            <div class="cart-icon">
                @await Component.InvokeAsync("Basket")
            </div>
        </div>
    </div>
</nav>

