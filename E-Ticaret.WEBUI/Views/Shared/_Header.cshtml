    <div class="top-links">
        <a asp-area="" asp-controller="Home" asp-action="About">Hakkımızda</a>
    </div>
    <div class="social-icons">
        <a href="https://www.instagram.com/detayflowers" target="_blank">
            <i class="fa-brands fa-instagram fa-3x"></i> 
        </a>
    </div>
    <div class="auth-links">
        @*      <a href="#"><i class="fa-solid fa-right-to-bracket"></i> Giriş Yapın</a>
            <a href="#"><i class="fa-solid fa-user-plus"></i> Üye Olun</a> *@
        <a asp-controller="Order" asp-action="GetOrder"><i class="fa-solid fa-truck-fast"></i> Sipariş Takibi</a>
