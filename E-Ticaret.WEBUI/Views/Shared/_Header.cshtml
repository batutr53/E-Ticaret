        <li><a href="/Home/About"><i class="fa-solid fa-info-circle"></i> Hakkımızda</a></li>
        <li><a href="/Home/ContactUs"><i class="fa-solid fa-envelope"></i> İletişim</a></li>
    </ul>
</div>
