<!-- Main Header -->
<header class="main-header">
    <a href="/" class="logo">
        <img src="/img/logo.png" height="150" width="100" alt="Detay Çiçekçilik">
    </a>

    <div class="contact-numbers">
      
        <div class="phone-row">
            <i class="fa-solid fa-phone phone-icon"></i>
            <a href="tel:+905333612554">+90 533 361 25 54</a>
        </div>
        <div class="phone-row">
            <i class="fa-solid fa-phone phone-icon"></i>
            <a href="tel:+902165945050">+90 216 594 50 50</a>
        </div>
    </div>


    <form action="/Product/">
        <div class="search-container">
            <input name="q" type="text" class="search-input" placeholder="Ne Aramıştınız?" aria-label="Arama">
            <button class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
        </div>
    </form>
</header> <!-- Navigation -->
<nav class="main-nav">
    <div class="nav-container">
        <button class="mobile-menu-btn">
            <i class="fa-solid fa-bars"></i>
        </button>
        <ul class="nav-links nav-left">
            <li><a href="/"><i class="fa-solid fa-house"></i></a></li>
        </ul>
        <ul class="nav-links nav-center">
            <li class="has-dropdown">
                <a href="#"><i class="fa-solid fa-list-ul"></i> KATEGORİLERİMİZ <i class="fa-solid fa-chevron-down"></i></a>
                <div class="dropdown-menu">
                    <div class="dropdown-content">
                        @await Component.InvokeAsync("Categories")
                    </div>
                </div>
            </li>
            @await Component.InvokeAsync("CategoriesMain")
            @*<li><a href="/Category?id=5"><i class="fa-solid fa-gift"></i> KADINLAR GÜNÜ ÇİÇEKLERİ</a></li>
            <li><a href="/Category?id=6"><i class="fa-solid fa-leaf"></i> ARANJMANLAR</a></li>
            <li><a href="/Category?id=7"><i class="fa-solid fa-seedling"></i> ORKİDELER</a></li>
            <li><a href="/Category?id=8"><i class="fa-solid fa-fan"></i> ÇİÇEK BUKETLERİ</a></li>*@
        </ul>
        <div class="cart-container">
            @await Component.InvokeAsync("Basket")
        </div>
    </div>
</nav>

