<section class="banner-grid">
    @foreach (var item in ViewBag.Sliders)
    {
        <div class="banner-item">
            <a href="@item.Link">
                <img src="/img/@item.Image" width="600" height="400" alt="Özel Tasarım Çiçekler">
                <div class="banner-overlay">
                    <h2 class="banner-title">@item.Title</h2>
                    <h3 class="banner-subtitle">@item.Description</h3>
                </div>
            </a>
        </div>
    }
</section>
