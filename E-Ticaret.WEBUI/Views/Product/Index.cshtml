@model List<E_Ticaret.Core.Entities.Product>
@using E_Ticaret.WEBUI.Helpers
@{
    var selectedSort = ViewBag.Sort as string ?? "default";
    var searchQuery = ViewBag.SearchQuery as string ?? string.Empty;
}

<section class="products-section">
    <div class="section-header">
        <h2>Ürünler</h2>
        <form method="get" asp-controller="Product" asp-action="Index" class="product-sort-form">
            <input type="hidden" name="q" value="@searchQuery" />
            <label for="product-sort">Sıralama</label>
            <select id="product-sort" name="sort" onchange="this.form.submit()">
                <option value="default" selected="@(selectedSort == "default")">Varsayılan sıralama</option>
                <option value="price-asc" selected="@(selectedSort == "price-asc")">Fiyat: Artan</option>
                <option value="price-desc" selected="@(selectedSort == "price-desc")">Fiyat: Azalan</option>
            </select>
        </form>
    </div>

    <div class="products-grid">
        @foreach (var item in Model)
        {
            var imageUrl = item.ProductImages?.FirstOrDefault()?.ImageUrl ?? "no-image.png";

            <div class="product-card">
                <a href="/urun/@item.ProductCode/@SeoSlugHelper.Generate(item.Name)" class="product-link">
                    <div class="product-image">
                        <img src="/img/@imageUrl" alt="@item.Name">
                        <div class="quick-view">
                            <i class="fa-solid fa-eye"></i>
                        </div>
                    </div>
                    <div class="product-info">
                        <h3 class="product-title">@item.Name</h3>
                        <div class="product-price">@item.Price.ToString("c")</div>
                    </div>
                </a>
                <form asp-action="AddItemToCart" asp-controller="Cart">
                    <input type="hidden" name="productId" value="@item.Id" />
                    <input type="hidden" value="1" name="quantity" />
                    <button class="add-to-cart-btn" type="submit">
                        <i class="fa-solid fa-cart-plus"></i> Sepete Ekle
                    </button>
                </form>
            </div>
        }
    </div>
</section>
