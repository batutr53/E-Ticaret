@model ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Detay";
}

<div class="product-detail-container">

    <div class="product-detail-image-wrapper">
        <div class="product-detail-main-image">
            <img id="mainImage"
                 src="/img/@(Model.Product?.ProductImages?.FirstOrDefault(x => x.IsDefault)?.ImageUrl
                 ?? Model.Product?.ProductImages?.FirstOrDefault()?.ImageUrl
                 ?? "no-image.png")"
                 alt="@Model.Product?.Name">
        </div>

        <div class="product-detail-thumbnails">
            @if (Model.Product?.ProductImages != null && Model.Product.ProductImages.Any())
            {
                foreach (var image in Model.Product.ProductImages)
                {
                    <img src="/img/@image.ImageUrl"
                         onclick="changeImage(this)"
                         class="@(image.IsDefault || image == Model.Product.ProductImages.FirstOrDefault() ? "active" : "")" />

                }
            }
        </div>
    </div>

    <div class="product-detail-info-wrapper">
        <div class="product-detail-title">@Model.Product?.Name</div>
        <div class="product-detail-description">
            @Model.Product?.Description
        </div>

        <div class="product-detail-order-box">
            <div class="product-detail-price">@Model.Product?.Price.ToString("c")</div>
            <form asp-action="AddItemToCart" asp-controller="Cart">
                <input type="hidden" name="productId" value="@Model.Product?.Id" />
                <input type="number" value="1" name="quantity" />
                <button class="product-detail-btn" type="submit">Sepete Ekle</button>
            </form>
        </div>
    </div>
</div>

<section class="products-section">
    <div class="section-header">
        <h2>Benzer Ürünler</h2>
    </div>

    <div class="products-grid">
        @foreach (var item in Model.RelatedProducts!)
        {
            var imageUrl = item.ProductImages.FirstOrDefault(x => x.IsDefault)?.ImageUrl
                 ?? item.ProductImages.FirstOrDefault()?.ImageUrl
                 ?? "no-image.png";
            <div class="product-card">
                <a href="/product/detail?productCode=@item.ProductCode" class="product-link">
                    <div class="product-image">
                        <img src="/img/@imageUrl" alt="@item.Name">
                    </div>
                    <div class="product-info">
                        <h3 class="product-title">@item.Name</h3>
                        <div class="product-price">@item.Price.ToString("c")</div>
                    </div>
                </a>
                <form asp-action="AddItemToCart" asp-controller="Cart">
                    <input type="hidden" name="productId" value="@item.Id" />
                    <input type="hidden" value="1" name="quantity" />
                    <button class="product-detail-btn" type="submit">Sepete Ekle</button>
                </form>
            </div>
        }
    </div>
</section>

<script>
    function changeImage(thumbnail) {
        document.getElementById("mainImage").src = thumbnail.src;

        // Aktif class'ı güncelle
        document.querySelectorAll(".product-detail-thumbnails img").forEach(img => {
            img.classList.remove("active");
        });
        thumbnail.classList.add("active");
    }
</script>
