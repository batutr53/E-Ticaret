@model E_Ticaret.Core.Entities.MobileBanner
@{
    ViewData["Title"] = "Mobil Banner Düzenle";
}
<h1 class="h3 mb-4 text-gray-800">Mobil Banner Düzenle</h1>
<div class="card shadow"><div class="card-body">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (!string.IsNullOrWhiteSpace(Model.Image))
        {
            <img src="/img/@Model.Image" alt="Mobil banner" class="img-thumbnail mb-3" style="max-height:150px" />
        }
        <div class="form-group">
            <label>Yeni Görsel</label>
            <input type="file" name="Image" accept="image/*" class="form-control-file" />
            <span asp-validation-for="Image" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Link">Bağlantı</label>
            <input asp-for="Link" class="form-control" />
            <span asp-validation-for="Link" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="OrderNo">Sıra</label>
            <input asp-for="OrderNo" type="number" min="0" class="form-control" />
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Aktif</label>
            <span asp-validation-for="IsActive" class="text-danger d-block"></span>
        </div>
        <button class="btn btn-primary" type="submit">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div></div>
