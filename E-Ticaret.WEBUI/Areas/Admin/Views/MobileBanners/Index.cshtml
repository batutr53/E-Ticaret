@model List<E_Ticaret.Core.Entities.MobileBanner>
@{
    ViewData["Title"] = "Mobil Bannerlar";
    var activeCount = (int)ViewBag.ActiveCount;
}
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 text-gray-800">Mobil Bannerlar</h1>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Yeni Banner</a>
</div>

@if (activeCount < 3)
{
    <div class="alert alert-warning">Mobil görünüm için 3 aktif banner önerilir. Şu anda @activeCount aktif banner var.</div>
}

<div class="card shadow">
    <div class="card-header d-flex justify-content-between">
        <span>Sürükleyerek sıralayın</span>
        <button id="saveOrder" class="btn btn-sm btn-primary">Sıralamayı Kaydet</button>
    </div>
    <div class="card-body">
        @Html.AntiForgeryToken()
        <ul id="sortable" class="list-unstyled">
            @foreach (var item in Model)
            {
                <li data-id="@item.Id" class="card mb-2 p-3 d-flex flex-row align-items-center">
                    <i class="fas fa-grip-vertical mr-3 text-muted"></i>
                    <img src="/img/@item.Image" alt="Mobil banner" style="width:120px;height:70px;object-fit:cover" class="mr-3 rounded" />
                    <div class="flex-grow-1">
                        <div><strong>Sıra:</strong> @item.OrderNo</div>
                        <div class="text-muted">@item.Link</div>
                        <span class="badge @(item.IsActive ? "badge-success" : "badge-secondary")">@(item.IsActive ? "Aktif" : "Pasif")</span>
                    </div>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning mr-2">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Banner silinsin mi?')">
                        <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                    </form>
                </li>
            }
        </ul>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script>
        $("#sortable").sortable({ handle: ".fa-grip-vertical" });
        $("#saveOrder").click(function () {
            const ids = $("#sortable li").map(function () { return $(this).data("id"); }).get();
            $.ajax({
                url: '@Url.Action("UpdateOrder")',
                method: "POST",
                contentType: "application/json",
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                data: JSON.stringify(ids),
                success: () => Swal.fire("Başarılı", "Sıralama kaydedildi.", "success"),
                error: () => Swal.fire("Hata", "Sıralama kaydedilemedi.", "error")
            });
        });
    </script>
}
