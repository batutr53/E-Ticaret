@model E_Ticaret.Core.Entities.Brand

@{
    ViewData["Title"] = "Marka Sil";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800 text-danger">
        <i class="fas fa-trash-alt"></i> Marka Sil
    </h1>

    <div class="alert alert-warning" role="alert">
        <strong>Dikkat!</strong> Bu markayı silmek üzeresiniz. Bu işlem geri alınamaz.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Marka Adı</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Açıklama</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Logo</dt>
                <dd class="col-sm-9">
                    <img src="/img/@Model.Logo" height="75" class="img-thumbnail" />
                </dd>

                <dt class="col-sm-3">Aktiflik</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">Pasif</span>
                    }
                </dd>

                <dt class="col-sm-3">Oluşturulma Tarihi</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Sil
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left"></i> Geri Dön
                </a>
            </form>
        </div>
    </div>
</div>
