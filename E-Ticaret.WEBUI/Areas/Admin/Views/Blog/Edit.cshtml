@model BlogEditViewModel
@using E_Ticaret.WEBUI.Helpers
@{ ViewData["Title"] = Model.Id == 0 ? "Yeni Blog Yazısı" : "Yazıyı Düzenle"; }
@section Head { <link rel="stylesheet" href="~/css/blog-admin.css" asp-append-version="true" /> }
<div class="blog-admin">
    <partial name="_Nav" />
    <div class="blog-admin-editor-heading"><div><a href="/Admin/Blog" class="text-muted small">← Yazılara dön</a><h2>@ViewData["Title"]</h2></div>@if (Model.Id > 0) { <a href="/Admin/Blog/Preview/@Model.Id" target="_blank" rel="noopener" class="btn btn-outline-secondary">Kaydedilmiş halini önizle ↗</a> }</div>
    <form asp-action="Save" method="post" enctype="multipart/form-data" id="blogEditorForm">
        <input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
        <div asp-validation-summary="All" class="text-danger blog-admin-errors" role="alert"></div>
        <div class="blog-admin-editor-grid">
            <div class="blog-admin-editor-main">
                <section class="blog-admin-panel blog-admin-form-panel"><span class="blog-admin-step">01 / YAZI</span><h3>Güzel bir hikâye, iyi bir başlıkla başlar.</h3>
                    <div class="form-group"><label asp-for="Title">Yazı başlığı <span class="text-danger">*</span></label><input asp-for="Title" class="form-control blog-admin-title-input" placeholder="Örn. Sevdiklerinize çiçek seçmenin incelikleri" maxlength="200" /><span asp-validation-for="Title" class="text-danger small"></span></div>
                    <div class="form-group mb-0"><label asp-for="Excerpt">Kısa açıklama</label><textarea asp-for="Excerpt" class="form-control" rows="3" maxlength="400" placeholder="Yazıyı birkaç cümleyle tanıtın…"></textarea><small class="form-text text-muted">Blog kartlarında ve yazının girişinde görünür. Boş bırakırsanız içerikten oluşturulur.</small></div>
                </section>
                <section class="blog-admin-panel blog-admin-form-panel"><span class="blog-admin-step">02 / İÇERİK</span><h3>İlhamınızı paylaşın.</h3><p class="small text-muted">Başlık, liste, bağlantı ve görsel eklemek için araç çubuğunu kullanın. Alt başlıklar yazıda otomatik içindekiler oluşturur.</p><label asp-for="BodyHtml" class="sr-only">Yazı içeriği</label><textarea asp-for="BodyHtml" id="blogBodyEditor" class="form-control" rows="22"></textarea><span asp-validation-for="BodyHtml" class="text-danger small"></span><noscript><p class="text-muted small mt-2">Bu alana güvenli HTML içerik girebilirsiniz.</p></noscript></section>
                <details class="blog-admin-panel blog-admin-seo"><summary>Arama motoru ayarları <span>İsteğe bağlı</span></summary><div class="blog-admin-form-panel"><p class="small text-muted">Boş bıraktığınız SEO alanları yazınızdan otomatik hazırlanır.</p><div class="form-group"><label asp-for="Slug">Yazı bağlantısı</label><div class="input-group"><div class="input-group-prepend"><span class="input-group-text">/blog/</span></div><input asp-for="Slug" class="form-control" readonly="@Model.SlugLocked" maxlength="220" placeholder="Baslıktan otomatik oluşturulur" data-slug-locked="@(Model.SlugLocked ? "true" : "false")" /></div><small class="form-text text-muted">@(Model.SlugLocked ? "Yayınlanmış yazının bağlantısı SEO için korunur." : "Türkçe karakterler otomatik dönüştürülür. İlk yayından sonra bağlantı sabit kalır.")</small><span asp-validation-for="Slug" class="text-danger small"></span></div><div class="form-group"><label asp-for="SeoTitle">SEO başlığı</label><input asp-for="SeoTitle" class="form-control" maxlength="70" /><span asp-validation-for="SeoTitle" class="text-danger small"></span></div><div class="form-group mb-0"><label asp-for="SeoDescription">SEO açıklaması</label><textarea asp-for="SeoDescription" class="form-control" maxlength="170" rows="3"></textarea><span asp-validation-for="SeoDescription" class="text-danger small"></span></div></div></details>
            </div>
            <aside class="blog-admin-editor-side">
                <section class="blog-admin-panel blog-admin-form-panel"><span class="blog-admin-step">03 / KAPAK</span><h3>İlk izlenim önemlidir.</h3><div class="blog-admin-cover-preview"><img id="blogCoverPreview" src="@BlogContent.CoverUrl(Model.ExistingCover)" alt="Kapak önizlemesi" /></div><label asp-for="Cover" class="btn btn-outline-success btn-block mt-3">Kapak görseli seç</label><input asp-for="Cover" type="file" accept="image/jpeg,image/png,image/webp" class="blog-admin-file" /><small class="d-block text-muted mt-2">Yatay görsel önerilir (1600 × 900 px). JPG, PNG veya WebP · En fazla 10 MB.</small><span asp-validation-for="Cover" class="text-danger small"></span><div class="form-group mt-3 mb-0"><label asp-for="CoverAlt">Görsel açıklaması</label><input asp-for="CoverAlt" class="form-control" maxlength="200" placeholder="Örn. Beyaz orkideler ve bakım malzemeleri" /><small class="text-muted form-text">Erişilebilirlik ve arama motorları için kullanılır.</small></div></section>
                <section class="blog-admin-panel blog-admin-form-panel"><span class="blog-admin-step">04 / YAYIN</span><h3>Son dokunuşlar.</h3><div class="form-group"><label asp-for="BlogCategoryId">Kategori</label><select asp-for="BlogCategoryId" class="form-control"><option value="">Genel / Çiçek Günlüğü</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name@(!category.IsActive ? " (Kapalı)" : "")</option> }</select><a href="/Admin/Blog/Categories" class="small d-inline-block mt-2" target="_blank" rel="noopener">Kategorileri yönet ↗</a></div><div class="form-group"><label asp-for="Author">Yazar</label><input asp-for="Author" class="form-control" maxlength="100" /></div><div class="form-group"><label asp-for="PublishAtLocal">Yayın tarihi</label><input asp-for="PublishAtLocal" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><small class="form-text text-muted">İstanbul saati. Boş bırakırsanız hemen yayınlanır. Gelecek tarih seçerseniz o tarihte görünür.</small></div><button type="submit" name="intent" value="publish" class="btn btn-success btn-block">@(Model.IsPublished ? "Yayını güncelle" : "Yayınla / Planla")</button><button type="submit" name="intent" value="draft" class="btn btn-light btn-block mt-2">Taslak olarak kaydet</button><p class="blog-admin-save-hint">Taslaklar ziyaretçilere görünmez. Önizleme için önce kaydedin.</p></section>
            </aside>
        </div>
    </form>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>
    <script src="~/js/admin-blog.js" asp-append-version="true"></script>
}
