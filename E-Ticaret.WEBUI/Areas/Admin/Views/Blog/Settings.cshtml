@model E_Ticaret.Core.Entities.BlogSetting
@using E_Ticaret.WEBUI.Helpers
@{ ViewData["Title"] = "Blog Görünümü"; }
@section Head { <link rel="stylesheet" href="~/css/blog-admin.css" asp-append-version="true" /> }
<div class="blog-admin"><partial name="_Nav" /><div class="blog-admin-panel blog-admin-form-panel" style="max-width:850px"><h2>Blogunuzu kişiselleştirin.</h2><p class="text-muted small mb-4">Liste ve yazı sayfalarının üst bölümünde görünen başlık, açıklama ve arka planı buradan yönetin.</p><form asp-action="Settings" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger"></div><div class="form-group"><label asp-for="Title">Blog başlığı</label><input asp-for="Title" class="form-control" maxlength="100" /></div><div class="form-group"><label asp-for="Description">Kısa tanıtım</label><textarea asp-for="Description" class="form-control" rows="3" maxlength="250"></textarea></div><div class="form-group"><label for="banner">Üst alan arka plan görseli</label><img class="blog-admin-banner-preview" src="@(Model.BannerImage == null ? "/img/blog/hero.svg" : BlogContent.CoverUrl(Model.BannerImage))" alt="Mevcut blog arka planı" /><input type="file" name="banner" id="banner" accept="image/jpeg,image/png,image/webp" class="form-control-file mt-3" /><small class="text-muted form-text">1600 × 360 px gibi yatay bir görsel seçin. Yeni görsel seçmezseniz mevcut görünüm korunur.</small></div><button class="btn btn-success" type="submit">Görünümü kaydet</button></form></div></div>
