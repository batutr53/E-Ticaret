@model E_Ticaret.Core.Entities.Address
@* Add reference to Bootstrap Icons if you use them below *@
@* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"> *@

@{
    ViewData["Title"] = $"Address Details: {Model.Title}"; // Dynamic title
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">@ViewData["Title"]</h4>
            @* Optional: Edit button can go here for quick access *@
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary" title="Edit Address">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                @* mb-0 to remove default bottom margin if footer is used *@
                <dt class="col-sm-3 col-md-2">@Html.DisplayNameFor(model => model.Title)</dt>
                <dd class="col-sm-9 col-md-10">@Html.DisplayFor(model => model.Title)</dd>

                <dt class="col-sm-3 col-md-2 border-top pt-2 mt-2">@Html.DisplayNameFor(model => model.City)</dt>
                <dd class="col-sm-9 col-md-10 border-top pt-2 mt-2">@Html.DisplayFor(model => model.City)</dd>

                <dt class="col-sm-3 col-md-2 border-top pt-2 mt-2">@Html.DisplayNameFor(model => model.District)</dt>
                <dd class="col-sm-9 col-md-10 border-top pt-2 mt-2">@Html.DisplayFor(model => model.District)</dd>

                <dt class="col-sm-3 col-md-2 border-top pt-2 mt-2">Full Address</dt> @* Changed label *@
                <dd class="col-sm-9 col-md-10 border-top pt-2 mt-2">@Html.DisplayFor(model => model.OpenAddress)</dd>

                <dt class="col-sm-3 col-md-2 border-top pt-2 mt-2">@Html.DisplayNameFor(model => model.IsActive)</dt>
                <dd class="col-sm-9 col-md-10 border-top pt-2 mt-2">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3 col-md-2 border-top pt-2 mt-2">Type</dt> @* Combined label *@
                <dd class="col-sm-9 col-md-10 border-top pt-2 mt-2">
                    @if (Model.IsDeliveryAddress)
                    {
                        <span class="badge bg-primary me-1">Default Delivery</span>
                    }
                    @if (Model.IsBillingAddress)
                    {
                        <span class="badge bg-info">Default Billing</span>
                    }
                    @if (!Model.IsDeliveryAddress && !Model.IsBillingAddress)
                    {
                        <span class="badge bg-light text-dark">Standard</span>
                    }
                </dd>

                @* Optional: Displaying technical/audit fields - style slightly differently *@
                <dt class="col-sm-3 col-md-2 border-top pt-2 mt-2 text-muted">@Html.DisplayNameFor(model => model.CreatedDate)</dt>
                <dd class="col-sm-9 col-md-10 border-top pt-2 mt-2 text-muted">@Model.CreatedDate.ToString("g")</dd> @* Format date 'g' = short date/time *@

                <dt class="col-sm-3 col-md-2 border-top pt-2 mt-2 text-muted">@Html.DisplayNameFor(model => model.AddressGuid)</dt>
                <dd class="col-sm-9 col-md-10 border-top pt-2 mt-2 text-muted small">@Html.DisplayFor(model => model.AddressGuid)</dd> @* Use 'small' for GUID *@

                <dt class="col-sm-3 col-md-2 border-top pt-2 mt-2 text-muted">@Html.DisplayNameFor(model => model.UserId)</dt>
                <dd class="col-sm-9 col-md-10 border-top pt-2 mt-2 text-muted small">@Html.DisplayFor(model => model.UserId)</dd> @* Use 'small' for UserId *@

            </dl>
        </div> @* End card-body *@

        <div class="card-footer bg-light text-end">
            @* Footer for actions *@
            @* Optionally move Edit button here if not in header *@
            @*
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                    <i class="bi bi-pencil-square"></i> Edit
                </a>
            *@
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div> @* End card *@

</div> @* End container *@

@* No scripts needed typically for details view unless you add interactions *@