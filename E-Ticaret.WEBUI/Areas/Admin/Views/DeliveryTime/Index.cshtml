@model List<E_Ticaret.Core.Entities.DeliveryTimeRange>
@{
    ViewData["Title"] = "Teslimat Saat Aralıkları";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Teslimat Saat Aralıkları</h1>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Saat Aralığı Listesi</h6>
            <a href="/Admin/DeliveryTime/Create" class="btn btn-success btn-sm">Yeni Ekle</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Aralık</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Aktif Mi?</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.RangeText</td>
                                <td>@item.StartTime.ToString("hh\\:mm")</td>
                                <td>@item.EndTime.ToString("hh\\:mm")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Admin/DeliveryTime/Edit/@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                                    <a href="/Admin/DeliveryTime/Delete/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>