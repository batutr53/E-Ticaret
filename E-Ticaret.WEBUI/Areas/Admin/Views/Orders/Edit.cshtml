@model E_Ticaret.Core.Entities.Order

@{
    ViewData["Title"] = "Siparişi Düzenle";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-edit text-primary"></i> Siparişi Düzenle
    </h1>

    <form asp-action="Edit" class="needs-validation">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <!-- Alıcı Bilgileri -->
            <div class="col-lg-6">
                <div class="card shadow-sm mb-4 border-left-primary">
                    <div class="card-header font-weight-bold text-primary">
                        <i class="fas fa-user"></i> Alıcı Bilgileri
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="FirstName">Ad</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="LastName">Soyad</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Phone">Telefon</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="City">Şehir</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="AddresLine">Adres</label>
                            <textarea asp-for="AddresLine" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="AddresLine" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CustomerId">Müşteri ID</label>
                            <input asp-for="CustomerId" class="form-control" />
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gönderen ve Sipariş -->
            <div class="col-lg-6">
                <div class="card shadow-sm mb-4 border-left-info">
                    <div class="card-header font-weight-bold text-info">
                        <i class="fas fa-paper-plane"></i> Gönderen Bilgileri
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="SenderFirstName">Ad</label>
                            <input asp-for="SenderFirstName" class="form-control" />
                            <span asp-validation-for="SenderFirstName" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="SenderLastName">Soyad</label>
                            <input asp-for="SenderLastName" class="form-control" />
                            <span asp-validation-for="SenderLastName" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="SenderPhone">Telefon</label>
                            <input asp-for="SenderPhone" class="form-control" />
                            <span asp-validation-for="SenderPhone" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="SenderEmail">E-Posta</label>
                            <input asp-for="SenderEmail" class="form-control" />
                            <span asp-validation-for="SenderEmail" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Description">Not</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-left-success">
                    <div class="card-header font-weight-bold text-success">
                        <i class="fas fa-box"></i> Sipariş Bilgileri
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="OrderDate">Tarih</label>
                            <input asp-for="OrderDate" class="form-control" />
                            <span asp-validation-for="OrderDate" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="OrderStatus">Durum</label>
                            <select asp-for="OrderStatus" class="form-control"
                                    asp-items="Html.GetEnumSelectList<E_Ticaret.Core.Entities.OrderStatus>()"></select>
                            <span asp-validation-for="OrderStatus" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="SubTotal">Ara Toplam</label>
                            <input asp-for="SubTotal" class="form-control" />
                            <span asp-validation-for="SubTotal" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DeliveryFree">Kargo</label>
                            <input asp-for="DeliveryFree" class="form-control" />
                            <span asp-validation-for="DeliveryFree" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TxnNo">İşlem No</label>
                            <input asp-for="TxnNo" class="form-control" />
                            <span asp-validation-for="TxnNo" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Oid">Sipariş Kodu (OID)</label>
                            <input asp-for="Oid" class="form-control" />
                            <span asp-validation-for="Oid" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save"></i> Kaydet
            </button>
            <a asp-action="Index" class="btn btn-secondary ml-2">
                <i class="fas fa-arrow-left"></i> Geri Dön
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
