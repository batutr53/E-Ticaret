@model E_Ticaret.Core.Entities.Order

@{
    ViewData["Title"] = "Sipariş Detayı";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-file-invoice"></i> Sipariş Detayı
    </h1>

    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow mb-4 border-left-primary">
                <div class="card-header font-weight-bold text-primary">Alıcı Bilgileri</div>
                <div class="card-body">
                    <p><strong>Ad Soyad:</strong> @Model.FirstName @Model.LastName</p>
                    <p><strong>Telefon:</strong> @Model.Phone</p>
                    <p><strong>Şehir:</strong> @Model.City</p>
                    <p><strong>Adres:</strong> @Model.AddresLine</p>
                    <p><strong>Müşteri ID:</strong> @Model.CustomerId</p>
                </div>
            </div>

            <div class="card shadow mb-4 border-left-info">
                <div class="card-header font-weight-bold text-info">Gönderen Bilgileri</div>
                <div class="card-body">
                    <p><strong>Ad Soyad:</strong> @Model.SenderFirstName @Model.SenderLastName</p>
                    <p><strong>Telefon:</strong> @Model.SenderPhone</p>
                    <p><strong>E-posta:</strong> @Model.SenderEmail</p>
                    <p><strong>Not:</strong> @Model.Description</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow mb-4 border-left-success">
                <div class="card-header font-weight-bold text-success">Sipariş Bilgileri</div>
                <div class="card-body">
                    <p><strong>Tarih:</strong> @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
                    <p><strong>Durum:</strong> <span class="badge badge-@GetStatusColor(Model.OrderStatus)">@Model.OrderStatus</span></p>
                    <p><strong>İşlem No:</strong> @Model.TxnNo</p>
                    <p><strong>Sipariş Kodu (OID):</strong> @Model.Oid</p>
                    <p><strong>Ara Toplam:</strong> @Model.SubTotal ₺</p>
                    <p><strong>Kargo:</strong> @Model.DeliveryFree ₺</p>
                    <h5 class="mt-3">Toplam: <span class="badge badge-pill badge-dark">@Model.GetTotal() ₺</span></h5>
                </div>
            </div>
        </div>
    </div>

    @if (Model.OrderItems?.Any() == true)
    {
        <div class="card shadow mb-5">
            <div class="card-header font-weight-bold text-dark">
                <i class="fas fa-boxes"></i> Sipariş Ürünleri
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered text-center">
                        <thead class="thead-light">
                            <tr>
                                <th>Ürün</th>
                                <th>Görsel</th>
                                <th>Fiyat</th>
                                <th>Adet</th>
                                <th>Ara Toplam</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td><img src="/img/@item.ProductImage" class="img-thumbnail" height="60" /></td>
                                    <td>@item.Price ₺</td>
                                    <td>@item.Quantity</td>
                                    <td><strong>@(item.Price * item.Quantity) ₺</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mb-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> Düzenle
        </a>
        <a asp-action="Index" class="btn btn-secondary ml-2">
            <i class="fas fa-arrow-left"></i> Geri Dön
        </a>
    </div>
</div>

@functions {
    public string GetStatusColor(E_Ticaret.Core.Entities.OrderStatus status)
    {
        return status switch
        {
            E_Ticaret.Core.Entities.OrderStatus.Pending => "secondary",
            E_Ticaret.Core.Entities.OrderStatus.Approved => "success",
            E_Ticaret.Core.Entities.OrderStatus.Completed => "primary",
            E_Ticaret.Core.Entities.OrderStatus.PaymentFailed => "danger",
            E_Ticaret.Core.Entities.OrderStatus.OnWay => "warning",
            _ => "light"
        };
    }
}
