@model IEnumerable<E_Ticaret.Core.Entities.Order>

@{
    ViewData["Title"] = "Siparişler";
    var durumlar = Enum.GetValues(typeof(E_Ticaret.Core.Entities.OrderStatus)).Cast<E_Ticaret.Core.Entities.OrderStatus>();
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-box-open text-primary"></i> Siparişler
    </h1>
    <form method="get" class="mb-4">
        <div class="card shadow-sm border-left-primary">
            <div class="card-body py-3">
                <div class="form-row align-items-end">
                    <div class="form-group col-lg-2 col-md-4 col-sm-6">
                        <label><i class="fas fa-filter text-primary"></i> Durum</label>
                        <select name="status" class="form-control">
                            <option value="">Tümü</option>
                            @foreach (var s in Enum.GetValues(typeof(E_Ticaret.Core.Entities.OrderStatus)).Cast<E_Ticaret.Core.Entities.OrderStatus>())
                            {
                                var statusText = s switch
                                {
                                    E_Ticaret.Core.Entities.OrderStatus.Pending => "Bekliyor",
                                    E_Ticaret.Core.Entities.OrderStatus.Approved => "Onaylandı",
                                    E_Ticaret.Core.Entities.OrderStatus.PaymentFailed => "Ödeme Hatalı",
                                    E_Ticaret.Core.Entities.OrderStatus.Completed => "Tamamlandı",
                                    E_Ticaret.Core.Entities.OrderStatus.OnWay => "Yolda",
                                    _ => s.ToString()
                                };
                                var selected = (ViewBag.StatusFilter?.ToString() == s.ToString()) ? "selected" : "";
                                @:<option value="@s" @selected>@statusText</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-lg-2 col-md-4 col-sm-6">
                        <label><i class="fas fa-user text-info"></i> Alıcı</label>
                        <input type="text" name="receiver" class="form-control" value="@ViewBag.ReceiverFilter" placeholder="Ad, Soyad veya Tel" />
                    </div>

                    <div class="form-group col-lg-2 col-md-4 col-sm-6">
                        <label><i class="fas fa-paper-plane text-warning"></i> Gönderen</label>
                        <input type="text" name="sender" class="form-control" value="@ViewBag.SenderFilter" placeholder="Ad, Soyad veya Tel" />
                    </div>

                    <div class="form-group col-lg-2 col-md-4 col-sm-6">
                        <label><i class="fas fa-calendar-alt text-success"></i> Başlangıç</label>
                        <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                    </div>

                    <div class="form-group col-lg-2 col-md-4 col-sm-6">
                        <label><i class="fas fa-calendar-check text-danger"></i> Bitiş</label>
                        <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                    </div>

                    <div class="form-group col-lg-2 col-md-4 col-sm-6 text-right">
                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fas fa-search"></i> Filtrele
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-list-ul"></i> Tüm Siparişler</h6>
            @*<a asp-action="Create" class="btn btn-sm btn-success shadow-sm">
                    <i class="fas fa-plus"></i> Yeni Sipariş
                </a>*@
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped text-center">
                    <thead class="thead-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Alıcı</th>
                            <th>Adres</th>
                            <th>Gönderen</th>
                            <th>Teslimat Tarihi/Saati</th>
                            <th>Durum</th>
                            <th>Toplam</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(x => x.OrderDate))
                        {
                            <tr>
                                <td><small class="text-muted">@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</small></td>
                                <td>
                                    <span> @item.FirstName @item.LastName </span><br />
                                    <small class="text-muted"> @item.Phone</small>
                                </td>
                                <td> <small class="text-muted">@item.AddresLine</small></td>
                                <td>
                                    <span>@item.SenderFirstName @item.SenderLastName</span><br />
                                    <small class="text-muted">@item.SenderPhone</small>
                                </td>
                                <td>
                                    <span> @(item.DeliveryDate?.ToString("dd.MM.yyyy") ?? "-")</span><br />
                                    <small class="text-muted">  @(item.DeliveryTimeRange?.RangeText ?? "-")</small>

                                </td>
                                <td>

                                    <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center justify-content-center">
                                        <input type="hidden" name="orderId" value="@item.Id" />

                                        <select name="orderStatus" class="form-control form-control-sm mr-2">
                                            @foreach (var status in Enum.GetValues(typeof(E_Ticaret.Core.Entities.OrderStatus)).Cast<E_Ticaret.Core.Entities.OrderStatus>())
                                            {
                                                var selected = item.OrderStatus == status ? "selected=\"selected\"" : "";
                                                var statusText = status switch
                                                {
                                                    E_Ticaret.Core.Entities.OrderStatus.Pending => "Bekliyor",
                                                    E_Ticaret.Core.Entities.OrderStatus.Approved => "Onaylandı",
                                                    E_Ticaret.Core.Entities.OrderStatus.PaymentFailed => "Ödeme Hatalı",
                                                    E_Ticaret.Core.Entities.OrderStatus.Completed => "Tamamlandı",
                                                    E_Ticaret.Core.Entities.OrderStatus.OnWay => "Yolda",
                                                    _ => status.ToString()
                                                };
                                                @:<option value="@status" @Html.Raw(selected)>@statusText</option>
                                            }
                                        </select>

                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Durumu Güncelle">
                                            <i class="fas fa-sync-alt"></i>
                                        </button>
                                    </form>

                                </td>
                                <td><strong>@(item.SubTotal + item.DeliveryFree) ₺</strong></td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" data-toggle="tooltip" title="Detay">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" data-toggle="tooltip" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" data-toggle="tooltip" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (ViewBag.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            var active = (ViewBag.CurrentPage == i) ? "active" : "";
                            <li class="page-item @active">
                                <a class="page-link" href="@Url.Action("Index", new {
                        page = i,
                        status = ViewBag.StatusFilter,
                        receiver = ViewBag.ReceiverFilter,
                        sender = ViewBag.SenderFilter,
                        startDate = ViewBag.StartDate,
                        endDate = ViewBag.EndDate
                    })">@i</a>
                </li>
            }
                    </ul>
                </nav>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}
