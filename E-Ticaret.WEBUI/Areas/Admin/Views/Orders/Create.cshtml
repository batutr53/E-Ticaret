@* @model E_Ticaret.Core.Entities.Order

@{
    ViewData["Title"] = "Siparişi Düzenle";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Siparişi Düzenle</h1>

    <div class="row">
        <div class="col-lg-10">
            <div class="card shadow mb-4">
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="OrderDate">Sipariş Tarihi</label>
                                    <input asp-for="OrderDate" class="form-control" />
                                    <span asp-validation-for="OrderDate" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="FirstName">Alıcı Adı</label>
                                    <input asp-for="FirstName" class="form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="LastName">Alıcı Soyadı</label>
                                    <input asp-for="LastName" class="form-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Phone">Telefon</label>
                                    <input asp-for="Phone" class="form-control" />
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="City">Şehir</label>
                                    <input asp-for="City" class="form-control" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="AddresLine">Adres</label>
                                    <input asp-for="AddresLine" class="form-control" />
                                    <span asp-validation-for="AddresLine" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="CustomerId">Müşteri ID</label>
                                    <input asp-for="CustomerId" class="form-control" />
                                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="OrderStatus">Sipariş Durumu</label>
                                    <select asp-for="OrderStatus" class="form-control" asp-items="Html.GetEnumSelectList<E_Ticaret.Core.Entities.OrderStatus>()"></select>
                                    <span asp-validation-for="OrderStatus" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="SenderFirstName">Gönderen Adı</label>
                                    <input asp-for="SenderFirstName" class="form-control" />
                                    <span asp-validation-for="SenderFirstName" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="SenderLastName">Gönderen Soyadı</label>
                                    <input asp-for="SenderLastName" class="form-control" />
                                    <span asp-validation-for="SenderLastName" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="SenderPhone">Gönderen Telefon</label>
                                    <input asp-for="SenderPhone" class="form-control" />
                                    <span asp-validation-for="SenderPhone" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="SenderEmail">Gönderen E-Posta</label>
                                    <input asp-for="SenderEmail" class="form-control" />
                                    <span asp-validation-for="SenderEmail" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Description">Not</label>
                                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="SubTotal">Ara Toplam</label>
                                    <input asp-for="SubTotal" class="form-control" />
                                    <span asp-validation-for="SubTotal" class="text-danger"></span>
                                </div>

