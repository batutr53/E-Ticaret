@model IEnumerable<E_Ticaret.Core.Entities.AppUser>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Kullanıcı Listesi</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Yeni Kullanıcı Ekle
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th>Ad</th>
                            <th>Soyad</th>
                            <th>E-Posta</th>
                            <th>Telefon</th>
                            <th>Kullanıcı Adı</th>
                            <th>Durum</th>
                            <th>Yetki</th>
                            <th>Kayıt Tarihi</th>
                            <th>GUID</th>
                            <th style="width: 120px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Surname</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@item.UserName</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Pasif</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsAdmin)
                                    {
                                        <span class="badge badge-primary">Yönetici</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dark">Kullanıcı</span>
                                    }
                                </td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><code>@item.UserGuid</code></td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="Detay">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
