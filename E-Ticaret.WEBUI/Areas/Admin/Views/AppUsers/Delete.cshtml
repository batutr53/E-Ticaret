@model E_Ticaret.Core.Entities.AppUser

@{
    ViewData["Title"] = "Kullanıcıyı Sil";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-user-times text-danger"></i> Kullanıcıyı Sil
    </h1>

    <div class="alert alert-warning">
        <strong>Dikkat!</strong> Bu kullanıcıyı silmek üzeresiniz. Bu işlem geri alınamaz.
    </div>

    <div class="card shadow-sm border-left-danger mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 font-weight-bold">Ad</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3 font-weight-bold">Soyad</dt>
                <dd class="col-sm-9">@Model.Surname</dd>

                <dt class="col-sm-3 font-weight-bold">E-Posta</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3 font-weight-bold">Telefon</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3 font-weight-bold">Kullanıcı Adı</dt>
                <dd class="col-sm-9">@Model.UserName</dd>

                <dt class="col-sm-3 font-weight-bold">Durum</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">Pasif</span>
                    }
                </dd>

                <dt class="col-sm-3 font-weight-bold">Yetki</dt>
                <dd class="col-sm-9">
                    @if (Model.IsAdmin)
                    {
                        <span class="badge badge-primary">Yönetici</span>
                    }
                    else
                    {
                        <span class="badge badge-dark">Kullanıcı</span>
                    }
                </dd>

                <dt class="col-sm-3 font-weight-bold">Kayıt Tarihi</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3 font-weight-bold">GUID</dt>
                <dd class="col-sm-9">@Model.UserGuid</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Sil
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left"></i> Listeye Dön
                </a>
            </form>
        </div>
    </div>
</div>
