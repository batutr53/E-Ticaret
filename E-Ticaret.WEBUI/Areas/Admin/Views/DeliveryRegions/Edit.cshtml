@model E_Ticaret.WEBUI.Areas.Admin.Models.DeliveryRegionEditModel
@{ ViewData["Title"] = "Teslimat Bölgesi"; var initial = Model.SelectedNeighborhoods.FirstOrDefault(); }
<div class="container-fluid">
    <h1 class="h3 mb-3">@(Model.Id == 0 ? "Yeni Teslimat Bölgesi" : "Teslimat Bölgesini Düzenle")</h1>
    <form asp-action="Save" method="post" id="delivery-region-form" data-region-id="@Model.Id" data-initial-district="@initial?.DistrictId">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <div class="card shadow mb-4"><div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-6"><label asp-for="Name">Bölge etiketi</label><input asp-for="Name" class="form-control" required maxlength="120" placeholder="Örnek: Yakın teslimat" /><small class="form-text text-muted">Yalnızca yönetim etiketi. Adres eşleştirmesi aşağıdaki mahalle kimlikleriyle yapılır.</small></div>
                <div class="form-group col-md-3"><label asp-for="Fee">Yol ücreti (TL)</label><input asp-for="Fee" class="form-control" inputmode="decimal" required /><small class="form-text text-muted">Ücretsiz teslimat için 0 girin.</small></div>
                <div class="form-group col-md-3 align-self-center"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Aktif</label></div></div>
            </div>
        </div></div>
        <div class="card shadow mb-4"><div class="card-body">
            <h2 class="h5">Teslimat Yapılan Mahalleler</h2>
            <p>İl ve ilçeyi seçip mahalleleri işaretleyin. İlçe değiştirseniz de önceki seçimleriniz korunur. Bir mahalle yalnızca bir bölgeye bağlanabilir.</p>
            <div class="form-row">
                <div class="form-group col-md-6"><label for="region-province">İl</label><select id="region-province" class="form-control"><option value="">İl seçiniz</option>@foreach (var p in Model.Provinces) { <option value="@p.Id" selected="@(p.Id == initial?.ProvinceId)">@p.Name</option> }</select></div>
                <div class="form-group col-md-6"><label for="region-district">İlçe</label><select id="region-district" class="form-control" disabled><option value="">Önce il seçiniz</option></select></div>
            </div>
            <p id="region-address-status" role="status" aria-live="polite"></p>
            <div id="region-neighborhood-options" class="row" style="max-height:360px;overflow-y:auto"></div>
            <h3 class="h6 mt-4">Seçilen mahalleler: <span id="selected-neighborhood-count">@Model.SelectedNeighborhoods.Count</span></h3>
            <div id="selected-neighborhoods">
                @foreach (var n in Model.SelectedNeighborhoods)
                { <div data-neighborhood-id="@n.Id" data-label="@n.Label"><input type="hidden" name="NeighborhoodIds" value="@n.Id" /><span>@n.Label</span></div> }
            </div>
        </div></div>
        <button type="submit" class="btn btn-primary mb-4">Bölgeyi ve Mahalleleri Kaydet</button>
        <a asp-action="Index" class="btn btn-outline-secondary mb-4 ml-2">Vazgeç</a>
    </form>
</div>
@section Scripts { <script src="~/js/admin-delivery-regions.js" asp-append-version="true"></script> }
