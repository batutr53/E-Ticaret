@model IEnumerable<E_Ticaret.Core.Entities.Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Kategori Listesi</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Yeni Kategori Ekle
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Ad</th>
                            <th>Görsel</th>
                            <th>Aktif</th>
                            <th>Üst Menü</th>
                            <th>Üst Kategori</th>
                            <th>Sıra No</th>
                            <th>Oluşturulma</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="/img/@item.Image" style="height: 80px; object-fit: cover;" class="img-thumbnail" />
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success">Evet</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Hayır</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsTopMenu)
                                    {
                                        <span class="badge badge-info">Evet</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light">Hayır</span>
                                    }
                                </td>
                                <td>
                                    @(item.ParentId == 0 ? "Ana Kategori" : $"ID: {item.ParentId}")
                                </td>
                                <td>@item.OrderNo</td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
