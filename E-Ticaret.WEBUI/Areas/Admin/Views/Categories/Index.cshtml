@model IEnumerable<E_Ticaret.Core.Entities.Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<style>
    /* Kategori hücresindeki isim kısalınca ... ile gösterilsin ve sağdaki ikon sabit kalsın */
    .category-cell { position: relative; }
    .category-name { display: block; padding-right: 56px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .category-site-link { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); }
    .category-site-link .btn { width: 36px; height: 36px; padding: 6px; display: inline-flex; align-items: center; justify-content: center; }
    .category-site-link .btn i { font-size: 14px; }
</style>

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Kategori Listesi</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Yeni Kategori Ekle
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Ad</th>
                            <th>Görsel</th>
                            <th>Aktif</th>
                            <th>Üst Menü</th>
                            <th>Üst Kategori</th>
                            <th>Sıra No</th>
                            <th>Oluşturulma</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="category-cell">
                                    <span class="category-name">
                                        <a asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-categoryId="@item.Id">@item.Name</a>
                                    </span>
                                    @{
                                        var categoryUrl = $"/Category?id={item.Id}";
                                    }
                                    <span class="category-site-link">
                                        <a class="btn btn-outline-primary rounded-circle" target="_blank" rel="noopener noreferrer" href="@categoryUrl" title="">
                                            <i class="fas fa-external-link-square-alt"></i>
                                        </a>
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="/img/@item.Image" style="height: 80px; object-fit: cover;" class="img-thumbnail" />
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success">Evet</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Hayır</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsTopMenu)
                                    {
                                        <span class="badge badge-info">Evet</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light">Hayır</span>
                                    }
                                </td>
                                <td>
                                    @(item.ParentId == 0 ? "Ana Kategori" : $"ID: {item.ParentId}")
                                </td>
                                <td>@item.OrderNo</td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
