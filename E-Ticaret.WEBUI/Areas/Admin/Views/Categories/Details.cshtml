@model E_Ticaret.Core.Entities.Category

@{
    ViewData["Title"] = "Kategori Detayları";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Kategori Detayları</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Kategori Adı</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Açıklama</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Görsel</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="/img/@Model.Image" height="100" class="img-thumbnail" />
                    }
                    else
                    {
                        <span>-</span>
                    }
                </dd>

                <dt class="col-sm-3">Aktif mi?</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Evet</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">Hayır</span>
                    }
                </dd>

                <dt class="col-sm-3">Üst Menüde Göster</dt>
                <dd class="col-sm-9">
                    @if (Model.IsTopMenu)
                    {
                        <span class="badge badge-info">Evet</span>
                    }
                    else
                    {
                        <span class="badge badge-light">Hayır</span>
                    }
                </dd>

                <dt class="col-sm-3">Üst Kategori</dt>
                <dd class="col-sm-9">
                    @(Model.ParentId == 0 ? "Ana Kategori" : $"ID: {Model.ParentId}")
                </dd>

                <dt class="col-sm-3">Sıra No</dt>
                <dd class="col-sm-9">@Model.OrderNo</dd>

                <dt class="col-sm-3">Oluşturulma Tarihi</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Düzenle
                </a>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left"></i> Geri Dön
                </a>
            </div>
        </div>
    </div>
</div>
