@model E_Ticaret.Core.Entities.News

@{
    ViewData["Title"] = "Haber Ekle";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-newspaper text-primary"></i> Yeni Haber Ekle
    </h1>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="form-group">
                            <label asp-for="Name" class="font-weight-bold">Başlık</label>
                            <input asp-for="Name" class="form-control" placeholder="Haber başlığı girin" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="font-weight-bold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Haber detaylarını yazın..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Image" class="font-weight-bold">Görsel</label>
                            <input asp-for="Image" type="file" class="form-control-file" />
                            <span asp-validation-for="Image" class="text-danger small"></span>
                        </div>

                        <div class="form-group form-check">
                            <input class="form-check-input" asp-for="IsActive" id="IsActive" />
                            <label class="form-check-label font-weight-bold" for="IsActive">Yayında</label>
                        </div>

                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-plus-circle"></i> Ekle
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ml-2">
                            <i class="fas fa-arrow-left"></i> Listeye Dön
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
