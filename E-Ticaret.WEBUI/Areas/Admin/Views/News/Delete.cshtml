@model E_Ticaret.Core.Entities.News

@{
    ViewData["Title"] = "Haberi Sil";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-trash-alt text-danger"></i> Haberi Sil
    </h1>

    <div class="alert alert-warning">
        <strong>Dikkat!</strong> Bu haberi silmek üzeresiniz. Bu işlem geri alınamaz.
    </div>

    <div class="card shadow-sm border-left-danger mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Başlık</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Açıklama</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Görsel</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="/img/@Model.Image" alt="Haber Görseli" class="img-thumbnail" style="max-height:120px;" />
                        <div class="text-muted mt-1">@Model.Image</div>
                    }
                    else
                    {
                        <span class="text-muted">Görsel bulunamadı</span>
                    }
                </dd>

                <dt class="col-sm-3">Oluşturulma Tarihi</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3">Durum</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">Pasif</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Sil
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left"></i> Listeye Dön
                </a>
            </form>
        </div>
    </div>
</div>
