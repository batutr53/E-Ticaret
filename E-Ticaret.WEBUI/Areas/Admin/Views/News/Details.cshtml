@model E_Ticaret.Core.Entities.News

@{
    ViewData["Title"] = "Haber Detayı";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-info-circle text-primary"></i> Haber Detayı
    </h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 font-weight-bold">Başlık</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3 font-weight-bold">Açıklama</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3 font-weight-bold">Görsel</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="/img/@Model.Image" alt="Haber Görseli" class="img-thumbnail" style="max-height:150px;" />
                        <div class="text-muted mt-1">@Model.Image</div>
                    }
                    else
                    {
                        <span class="text-muted">Görsel bulunamadı</span>
                    }
                </dd>

                <dt class="col-sm-3 font-weight-bold">Oluşturulma Tarihi</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3 font-weight-bold">Durum</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">Pasif</span>
                    }
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Düzenle
                </a>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left"></i> Listeye Dön
                </a>
            </div>
        </div>
    </div>
</div>
