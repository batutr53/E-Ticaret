@model E_Ticaret.Core.Entities.Product
@{
    ViewData["Title"] = "Ürün Detayı";
}
<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" />

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Ürün Detayları</h1>

    <div class="card shadow mb-4">
        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-3">Ürün Adı</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Açıklama</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Görseller</dt>
                <dd class="col-sm-9">
                    @if (Model.ProductImages != null && Model.ProductImages.Any())
                    {
                        <ul id="sortableImages" class="list-unstyled d-flex flex-wrap">
                            @foreach (var image in Model.ProductImages.OrderBy(i => i.Order))
                            {
                                <li class="sortable-item m-2 text-center" data-id="@image.Id" style="width: 160px;">
                                    <img src="/img/@image.ImageUrl" class="img-thumbnail mb-1"
                                         style="height:100px; object-fit:contain; cursor: zoom-in;" data-img="/img/@image.ImageUrl"
                                         onclick="zoomImage(this)" />

                                    <span class="badge badge-@(image.IsDefault ? "success" : "secondary") d-block mt-1">
                                        @(image.IsDefault ? "✓ Kapak Görsel" : "Kapak Değil")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Görsel yok</span>
                    }
                </dd>

                <dt class="col-sm-3">Fiyat</dt>
                <dd class="col-sm-9">@Model.Price ₺</dd>

                <dt class="col-sm-3">Ürün Kodu</dt>
                <dd class="col-sm-9">@Model.ProductCode</dd>

                <dt class="col-sm-3">Stok</dt>
                <dd class="col-sm-9">@Model.Stock</dd>

                <dt class="col-sm-3">Aktif mi?</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Evet</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">Hayır</span>
                    }
                </dd>

                <dt class="col-sm-3">Anasayfada Göster</dt>
                <dd class="col-sm-9">
                    @if (Model.IsHome)
                    {
                        <span class="badge badge-info">Evet</span>
                    }
                    else
                    {
                        <span class="badge badge-light">Hayır</span>
                    }
                </dd>

                <dt class="col-sm-3">Kategoriler</dt>
                <dd class="col-sm-9">
                    @foreach (var pc in Model.ProductCategories)
                    {
                        <span class="badge badge-pill badge-primary mr-1">@pc.Category.Name</span>
                    }
                </dd>

                <dt class="col-sm-3">Marka</dt>
                <dd class="col-sm-9">@Model.Brand?.Name</dd>

                <dt class="col-sm-3">Sıra No</dt>
                <dd class="col-sm-9">@Model.OrderNo</dd>

                <dt class="col-sm-3">Oluşturulma Tarihi</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Düzenle
                </a>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left"></i> Geri Dön
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Zoom Modal -->
<div class="modal fade" id="zoomModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center">
                <img id="zoomModalImage" src="" class="img-fluid rounded" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script>
        function zoomImage(img) {
            const imgSrc = $(img).data("img");
            $('#zoomModalImage').attr('src', imgSrc);
            $('#zoomModal').modal('show');
        }
    </script>
}
