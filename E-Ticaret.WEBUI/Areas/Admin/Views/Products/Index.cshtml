@model IEnumerable<E_Ticaret.Core.Entities.Product>

@{
    ViewData["Title"] = "Ürün Listesi";
}

<div class="container-fluid">
    <!-- Sayfa Başlığı -->
    <h1 class="h3 mb-4 text-gray-800">Ürün Listesi</h1>

    <!-- Yeni Ürün Butonu -->
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Yeni Ürün Ekle
        </a>
    </div>

    <!-- Ürünler Tablosu -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Ad</th>
                            <th>Açıklama</th>
                            <th>Görsel</th>
                            <th>Fiyat</th>
                            <th>Ürün Kodu</th>
                            <th>Stok</th>
                            <th>Aktif</th>
                            <th>Anasayfa</th>
                            <th>Kategoriler</th>
                            <th>Marka</th>
                            <th>Sıra No</th>
                            <th>Oluşturulma</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>
                                    <img src="/img/@item.Image" alt="@item.Name" style="height: 80px; object-fit: cover;" class="img-thumbnail" />
                                </td>
                                <td>@item.Price ₺</td>
                                <td>@item.ProductCode</td>
                                <td>@item.Stock</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success">Evet</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Hayır</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsHome)
                                    {
                                        <span class="badge badge-info">Evet</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light">Hayır</span>
                                    }
                                </td>
                                <td>
                                    @string.Join(", ", item.ProductCategories.Select(pc => pc.Category.Name))
                                </td>
                                <td>@item.Brand?.Name</td>
                                <td>@item.OrderNo</td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
