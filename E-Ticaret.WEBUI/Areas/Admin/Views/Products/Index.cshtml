@model IEnumerable<E_Ticaret.Core.Entities.Product>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Ürün Listesi";
    string nameFilter = ViewBag.NameFilter ?? "";
    string isActiveFilter = ViewBag.IsActiveFilter ?? "";
    string isHomeFilter = ViewBag.IsHomeFilter ?? "";
}
<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Ürün Listesi</h1>
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Yeni Ürün Ekle
        </a>
    </div>
    @using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "mb-4" }))
    {
        <div class="card shadow-sm p-3">
            <div class="form-row align-items-end">
                <div class="form-group col-md-3">
                    <label>Ürün Adı</label>
                    <input type="text" name="name" value="@nameFilter" class="form-control" />
                </div>

                <div class="form-group col-md-2">
                    <label>Aktif</label>
                    <select name="isActive" class="form-control">
                        <option value="">Tümü</option>
                        <option value="true" selected="@(string.Equals(isActiveFilter, "true", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Evet</option>
                        <option value="false" selected="@(string.Equals(isActiveFilter, "false", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Hayır</option>
                    </select>
                </div>

                <div class="form-group col-md-2">
                    <label>Anasayfa</label>
                    <select name="isHome" class="form-control">
                        <option value="">Tümü</option>
                        <option value="true" selected="@(string.Equals(isHomeFilter, "true", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Evet</option>
                        <option value="false" selected="@(string.Equals(isHomeFilter, "false", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Hayır</option>

                    </select>
                </div>

                <div class="form-group col-md-3">
                    <label>Marka</label>
                    @Html.DropDownList("brandId", ViewBag.BrandList as SelectList, "Tümü", new { @class = "form-control" })
                </div>

                <div class="form-group col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter"></i> Filtrele
                    </button>
                </div>
            </div>
        </div>
    }


    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th>Ürün Kodu</th>
                            <th>Ad</th>
                            <th>Görsel</th>
                            <th>Fiyat</th>
                            <th>Stok</th>
                            <th>Aktif</th>
                            <th>Anasayfa</th>
                            <th>Kategoriler</th>
                            <th>Oluşturulma</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var defaultImage = item.ProductImages?.FirstOrDefault(x => x.IsDefault) ?? item.ProductImages?.FirstOrDefault();
                            <tr>
                                <td>@item.ProductCode</td>

                                <td>@item.Name</td>
                                <td>
                                    @if (defaultImage != null)
                                    {
                                        <div class="position-relative d-inline-block">
                                            <img src="/img/@defaultImage.ImageUrl" class="img-thumbnail"
                                                 style="height: 80px; object-fit: cover; cursor: pointer;"
                                                 data-toggle="modal" data-target="#previewModal-@item.Id" />
                                            <span class="badge badge-success position-absolute" style="top:5px; left:5px;">Kapak</span>
                                        </div>

                                        <!-- Modal -->
                                        <div class="modal fade" id="previewModal-@item.Id" tabindex="-1" role="dialog">
                                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">@item.Name - Görseller</h5>
                                                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <ul class="sortable-images list-unstyled d-flex flex-wrap" data-product-id="@item.Id">
                                                            @foreach (var image in item.ProductImages.OrderBy(i => i.Order))
                                                            {
                                                                <li class="sortable-item m-2 text-center" data-id="@image.Id" style="width:160px;">
                                                                    <img src="/img/@image.ImageUrl" class="img-thumbnail mb-1" style="height:100px; object-fit:contain;" />
                                                                    <div class="mt-1">
                                                                        <button type="button" class="btn btn-sm btn-outline-@(image.IsDefault ? "success" : "secondary") set-default w-100"
                                                                                data-product-id="@item.Id" data-image-id="@image.Id">
                                                                            @(image.IsDefault ? "✓ Kapak" : "Kapak Yap")
                                                                        </button>
                                                                        <button type="button" class="btn btn-sm btn-danger mt-1 delete-image w-100"
                                                                                data-product-id="@item.Id" data-image-url="@image.ImageUrl">
                                                                            <i class="fas fa-trash"></i> Sil
                                                                        </button>
                                                                    </div>
                                                                </li>
                                                            }
                                                        </ul>
                                                        <button type="button" class="btn btn-primary save-order mt-3" data-product-id="@item.Id">
                                                            Sıralamayı Kaydet
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Yok</span>
                                    }
                                </td>
                                <td>@item.Price ₺</td>
                                <td>@item.Stock</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success">Evet</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Hayır</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsHome)
                                    {
                                        <span class="badge badge-info">Evet</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light">Hayır</span>
                                    }
                                </td>
                                <td>@string.Join(", ", item.ProductCategories.Select(x => x.Category.Name))</td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"><i class="fas fa-trash-alt"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
                @if (ViewBag.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination justify-content-center">
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                var active = (ViewBag.CurrentPage == i) ? "active" : "";
                                <li class="page-item @active">
                                    <a class="page-link" href="@Url.Action("Index", new {
           page = i,
           name = ViewBag.NameFilter,
           isActive = ViewBag.IsActiveFilter,
           isHome = ViewBag.IsHomeFilter
       })">@i</a>
</li>
}
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>


</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(function () {
            $(".sortable-images").sortable();

            $(".save-order").click(function () {
                const productId = $(this).data("product-id");
                const orderedIds = [];

                $(this).closest(".modal-body").find(".sortable-item").each(function () {
                    orderedIds.push($(this).data("id"));
                });

                fetch('/Admin/Products/SaveImageOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(orderedIds)
                }).then(res => {
                    if (res.ok) {
                        alert("Sıralama kaydedildi.");
                        location.reload();
                    }
                });
            });

            $(".set-default").click(function () {
                const productId = $(this).data("product-id");
                const imageId = $(this).data("image-id");

                fetch('/Admin/Products/SetDefaultImage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId, imageId })
                }).then(res => {
                    if (res.ok) location.reload();
                });
            });

            $(".delete-image").click(function () {
                if (!confirm("Görsel silinsin mi?")) return;

                const productId = $(this).data("product-id");
                const imageUrl = $(this).data("image-url");

                fetch('/Admin/Products/DeleteImage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId, imageUrl })
                }).then(res => {
                    if (res.ok) location.reload();
                });
            });
        });
    </script>
}
