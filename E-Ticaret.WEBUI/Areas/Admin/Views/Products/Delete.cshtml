@model E_Ticaret.Core.Entities.Product

@{
    ViewData["Title"] = "Ürünü Sil";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Ürünü Sil</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <strong>Dikkat!</strong> Bu ürünü silmek üzeresiniz. Bu işlem geri alınamaz. Devam etmek istediğinize emin misiniz?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Ürün Adı</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Açıklama</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Görseller</dt>
                <dd class="col-sm-9">
                    @if (Model.ProductImages != null && Model.ProductImages.Any())
                    {
                        <div class="d-flex flex-wrap">
                            @foreach (var img in Model.ProductImages)
                            {
                                <div class="m-1 text-center">
                                    <img src="@($"/img/{img.ImageUrl}")"
                                         style="width: 100px; height: 100px; object-fit: cover;"
                                         class="img-thumbnail" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Görsel yok</span>
                    }
                </dd>

                <dt class="col-sm-3">Fiyat</dt>
                <dd class="col-sm-9">@Model.Price.ToString("c")</dd>

                <dt class="col-sm-3">Ürün Kodu</dt>
                <dd class="col-sm-9">@Model.ProductCode</dd>

                <dt class="col-sm-3">Stok</dt>
                <dd class="col-sm-9">@Model.Stock</dd>

                <dt class="col-sm-3">Aktif mi?</dt>
                <dd class="col-sm-9">
                    <span class="badge badge-@(Model.IsActive ? "success" : "secondary")">
                        @(Model.IsActive ? "Evet" : "Hayır")
                    </span>
                </dd>

                <dt class="col-sm-3">Anasayfada Göster</dt>
                <dd class="col-sm-9">
                    <span class="badge badge-@(Model.IsHome ? "info" : "light")">
                        @(Model.IsHome ? "Evet" : "Hayır")
                    </span>
                </dd>

                <dt class="col-sm-3">Kategoriler</dt>
                <dd class="col-sm-9">
                    @foreach (var pc in Model.ProductCategories)
                    {
                        <span class="badge badge-pill badge-primary mr-1">@pc.Category.Name</span>
                    }
                </dd>

                <dt class="col-sm-3">Marka</dt>
                <dd class="col-sm-9">@Model.Brand?.Name</dd>

                <dt class="col-sm-3">Sıra No</dt>
                <dd class="col-sm-9">@Model.OrderNo</dd>

                <dt class="col-sm-3">Oluşturulma Tarihi</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash-alt"></i> Kalıcı Olarak Sil
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left"></i> Geri Dön
                </a>
            </form>
        </div>
    </div>
</div>
