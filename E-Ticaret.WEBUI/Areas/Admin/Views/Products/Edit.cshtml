@model E_Ticaret.Core.Entities.Product

@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="container-fluid">
    <!-- Sayfa Başlığı -->
    <h1 class="h3 mb-4 text-gray-800">Ürün Güncelle</h1>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="Image" />

                        <div class="form-group">
                            <label asp-for="Name">Ürün Adı</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Image">Ürün Görseli</label>
                            <input asp-for="Image" type="file" class="form-control-file" />
                            <span asp-validation-for="Image" class="text-danger"></span>
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <div class="mt-2">
                                    <img src="/img/@Model.Image" height="75" class="img-thumbnail" />
                                    <div class="form-check mt-1">
                                        <input type="checkbox" name="cbRemoveImage" class="form-check-input" id="removeImage">
                                        <label for="removeImage" class="form-check-label">Görseli Sil</label>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="form-group">
                            <label asp-for="Price">Fiyat</label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ProductCode">Ürün Kodu</label>
                            <input asp-for="ProductCode" class="form-control" />
                            <span asp-validation-for="ProductCode" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Stock">Stok Miktarı</label>
                            <input asp-for="Stock" class="form-control" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>

                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label class="form-check-label" asp-for="IsActive">Aktif mi?</label>
                        </div>

                        <div class="form-check">
                            <input asp-for="IsHome" class="form-check-input" />
                            <label class="form-check-label" asp-for="IsHome">Anasayfada Göster</label>
                        </div>

                        <div class="form-group mt-3">
                            <label for="categories">Kategoriler</label>
                            <select name="CategoryIds" multiple class="form-control">
                                @foreach (var category in (MultiSelectList)ViewData["Categories"])
                                {
                                    var selected = category.Selected ? "selected=\"selected\"" : "";
                                    @:<option value="@category.Value" @Html.Raw(selected)>@category.Text</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="BrandId">Marka</label>
                            <select asp-for="BrandId" class="form-control" asp-items="ViewBag.BrandId">
                                <option value="">Marka Seçiniz</option>
                            </select>
                            <span asp-validation-for="BrandId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="OrderNo">Sıra No</label>
                            <input asp-for="OrderNo" class="form-control" />
                            <span asp-validation-for="OrderNo" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Güncelle
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ml-2">
                            <i class="fas fa-arrow-left"></i> Geri Dön
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
