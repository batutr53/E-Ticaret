@model E_Ticaret.Core.Entities.Product
@{
    ViewData["Title"] = "Ürün Ekle";
}
<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" />

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Yeni Ürün Ekle</h1>

    <div class="row">
        <div class="col-lg-10">
            <div class="card shadow mb-4">
                <div class="card-body">
                    <form asp-action="Create" enctype="multipart/form-data" id="productForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="form-group">
                            <label asp-for="Name">Ürün Adı</label>
                            <input asp-for="Name" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Description">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Ürün Görselleri</label>
                            <input type="file" id="imageInput" name="Images" multiple class="form-control-file" />
                            <small class="form-text text-muted">Birden fazla görsel seçebilirsiniz.</small>
                        </div>

                        <div id="previewArea" class="d-flex flex-wrap mt-3"></div>
                        <input type="hidden" id="imageOrderInput" name="ImageOrder" />
                        <input type="hidden" id="defaultImageIndex" name="DefaultImageIndex" />

                        <div class="form-group mt-3">
                            <label asp-for="Price">Fiyat</label>
                            <input asp-for="Price" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Stock">Stok Miktarı</label>
                            <input asp-for="Stock" class="form-control" />
                        </div>

                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label class="form-check-label" asp-for="IsActive">Aktif mi?</label>
                        </div>

                        <div class="form-check">
                            <input asp-for="IsHome" class="form-check-input" />
                            <label class="form-check-label" asp-for="IsHome">Anasayfada Göster</label>
                        </div>

                        <hr />
                        <div class="form-group mt-3">
                            <label>Kategoriler</label>
                            <div class="category-zone d-flex flex-wrap gap-3">

                                <!-- Sol: ID = 1 (Canlı) -->
                                <div class="category-block main-category">
                                    <strong>Kategori</strong>
                                    @foreach (var cat in ((MultiSelectList)ViewData["Categories"]).Where(c => c.Value == "1"))
                                    {
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input main-category-check" name="CategoryIds" value="1" id="cat_1" checked />
                                            <label class="form-check-label" for="cat_@cat.Value">@cat.Text</label>
                                        </div>
                                    }
                                </div>


                                <!-- Alt Alta: ID = 3,4 (Hediyelik) -->
                                <div class="category-block main-category">
                                    <strong>Ana Kategori</strong>
                                    @foreach (var cat in ((MultiSelectList)ViewData["Categories"]).Where(c => c.Value == "3" || c.Value == "4" || c.Value == "2"))
                                    {
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input main-category-check" name="CategoryIds" value="@cat.Value" id="cat_@cat.Value" />
                                            <label class="form-check-label" for="cat_@cat.Value">@cat.Text</label>
                                        </div>
                                    }
                                </div>

                                <!-- Sağ: Diğer kategoriler -->
                                <div class="category-block sub-category" id="subCategoryContainer">
                                    <strong>Alt Kategoriler</strong>
                                    @foreach (var cat in ((MultiSelectList)ViewData["Categories"]).Where(c => !new[] { "1", "2", "3", "4" }.Contains(c.Value)))
                                    {
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input sub-category-check" name="CategoryIds" value="@cat.Value" id="cat_@cat.Value" />
                                            <label class="form-check-label" for="cat_@cat.Value">@cat.Text</label>
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="BrandId">Marka</label>
                            <select asp-for="BrandId" class="form-control" asp-items="ViewBag.BrandId">
                                <option value="">Marka Seçiniz</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="OrderNo">Sıra No</label>
                            <input asp-for="OrderNo" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ml-2">
                            <i class="fas fa-arrow-left"></i> Geri Dön
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .category-block {
            border: 1px solid #ccc;
            padding: 10px;
            border-radius: 6px;
            background: #f8f9fa;
            min-width: 200px;
        }

        .sub-category {
            opacity: 0.5;
            pointer-events: none;
        }

        .category-zone .form-check-label {
            font-size: 14px;
        }

        .category-block input:checked ~ label {
            font-weight: bold;
            color: #28a745;
        }
    </style>

    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script>
        const previewArea = document.getElementById("previewArea");
        const imageInput = document.getElementById("imageInput");
        let defaultImage = 0;

        imageInput.addEventListener("change", function () {
            previewArea.innerHTML = "";

            Array.from(imageInput.files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const wrapper = document.createElement("div");
                    wrapper.className = "sortable-item m-2 text-center";
                    wrapper.dataset.index = index;
                    wrapper.style.width = "160px";
                    wrapper.innerHTML = `
                        <img src="${e.target.result}" class="img-thumbnail mb-1 preview-image" style="height:100px; object-fit:contain;" />
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 mt-1 set-cover-btn" data-index="${index}">
                            Kapak Yap
                        </button>
                    `;
                    previewArea.appendChild(wrapper);
                    updateOrder();
                };
                reader.readAsDataURL(file);
            });
        });

        $(function () {
            $("#previewArea").sortable({
                update: function () {
                    updateOrder();
                }
            });
        });

        function updateOrder() {
            const order = [];

            $("#previewArea .sortable-item").each(function (i) {
                $(this).attr("data-index", i);
                order.push(i);
            });

            const orderString = order.join(",");
            $("#imageOrderInput").val(orderString);
        }

        $(document).on("click", ".set-cover-btn", function () {
            $(".set-cover-btn").removeClass("btn-success").addClass("btn-outline-secondary").text("Kapak Yap");
            $(this).removeClass("btn-outline-secondary").addClass("btn-success").text("✓ Kapak");

            defaultImage = $(this).data("index");
            $("#defaultImageIndex").val(defaultImage);
        });

        $(document).ready(function () {
            $("#defaultImageIndex").val(0);

            // Ana kategori seçilince alt kategorileri aç/kapat
            $(".main-category-check").on("change", function () {
                const anyMainChecked = $(".main-category-check:checked").length > 0;
                if (anyMainChecked) {
                    $("#subCategoryContainer").removeClass("sub-category");
                } else {
                    $("#subCategoryContainer").addClass("sub-category");
                    $(".sub-category-check").prop("checked", false);
                }
            });
        });
    </script>
}
