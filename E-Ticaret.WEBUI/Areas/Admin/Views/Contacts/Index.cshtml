@model IEnumerable<E_Ticaret.Core.Entities.Contact>

@{
    ViewData["Title"] = "İletişim Mesajları";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800"><i class="fas fa-envelope"></i> İletişim Formu Mesajları</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Email</th>
                            <th>Telefon</th>
                            <th>Konu</th>
                            <th>Mesaj</th>
                            <th>Tarih</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.NameSurname</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@item.Subject</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Message) && item.Message.Length > 50)
                                    {
                                        @item.Message.Substring(0, 50)

                                        <span class="text-muted">... (devamı)</span>
                                    }
                                    else
                                    {
                                        @item.Message
                                    }
                                </td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="Detay">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
