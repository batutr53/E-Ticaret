@model E_Ticaret.Core.Entities.Slider

@{
    ViewData["Title"] = "Slider Sil";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-trash-alt text-danger"></i> Slider Sil
    </h1>

    <div class="alert alert-warning">
        <strong>Dikkat!</strong> Bu slider'ı silmek üzeresiniz. Bu işlem geri alınamaz.
    </div>

    <div class="card shadow-sm mb-4 border-left-danger">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Başlık</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Açıklama</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Görsel</dt>
                <dd class="col-sm-9">
                    <img src="/img/@Model.Image" alt="Slider Görseli" class="img-thumbnail" style="max-height:120px;" />
                    <div class="mt-1 text-muted">@Model.Image</div>
                </dd>

                <dt class="col-sm-3">Durum</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">Pasif</span>
                    }
                </dd>

                <dt class="col-sm-3">Bağlantı Linki</dt>
                <dd class="col-sm-9">
                    <a href="@Model.Link" target="_blank">@Model.Link</a>
                </dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Sil
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left"></i> Listeye Dön
                </a>
            </form>
        </div>
    </div>
</div>
