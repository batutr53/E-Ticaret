@model E_Ticaret.Core.Entities.Slider

@{
    ViewData["Title"] = "Slider Ekle";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-sliders-h text-primary"></i> Yeni Slider Ekle
    </h1>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="form-group">
                            <label asp-for="Title" class="font-weight-bold">Başlık</label>
                            <input asp-for="Title" class="form-control" placeholder="Slider başlığı" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="font-weight-bold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Slider açıklaması..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Image" class="font-weight-bold">Görsel</label>
                            <input asp-for="Image" type="file" class="form-control-file" />
                            <span asp-validation-for="Image" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Link" class="font-weight-bold">Yönlendirme Linki</label>
                            <input asp-for="Link" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="Link" class="text-danger small"></span>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="DisplayType" class="font-weight-bold">Gösterim Tipi</label>
                                <select asp-for="DisplayType" asp-items="Html.GetEnumSelectList<E_Ticaret.Core.Entities.SliderDisplayType>()" class="form-control"></select>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="OrderNo" class="font-weight-bold">Sıra</label>
                                <input asp-for="OrderNo" type="number" min="0" class="form-control" />
                            </div>
                        </div>

                        <div class="form-group form-check">
                            <input class="form-check-input" asp-for="IsActive" />
                            <label class="form-check-label font-weight-bold" asp-for="IsActive">
                                Aktif Olarak Yayınla
                            </label>
                        </div>

                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-plus-circle"></i> Ekle
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ml-2">
                            <i class="fas fa-arrow-left"></i> Listeye Dön
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
